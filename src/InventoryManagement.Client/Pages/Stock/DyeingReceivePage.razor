@page "/stock/dyeing-receive"
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>Dyeing Receive - Dyed Yarn Inward</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-2">
    <div class="mb-6">
        <MudText Typo="Typo.h4" Class="font-weight-bold animated-gradient-text" Style="font-family: 'Outfit';">
            Dyeing Material Receive
        </MudText>
        <MudText Typo="Typo.body2" Class="text-slate-400">
            Receive dyed warp and weft yarn from dyers, record wastage, and update dyed yarn stock
        </MudText>
    </div>

    <EditForm Model="@_receive" OnValidSubmit="SaveReceive">
        <DataAnnotationsValidator />
        <MudGrid>
            <!-- Header Panel -->
            <MudItem xs="12" md="4">
                <MudPaper Class="glass-panel pa-6 mb-4">
                    <MudText Typo="Typo.h6" Class="text-slate-200 mb-4" Style="font-family: 'Outfit';">
                        <MudIcon Icon="@Icons.Material.Filled.Receipt" Class="mr-2" /> Header Info
                    </MudText>

                    <MudDatePicker Label="Receive Date" @bind-Date="_receiveDate" Required="true" Variant="Variant.Outlined" Class="mb-4 text-slate-200" />

                    <MudSelect T="Guid" Label="Select Dyer" Value="_receive.DyerId" Required="true" RequiredError="Dyer is required" Variant="Variant.Outlined" Class="mb-4 text-slate-200" ValueChanged="OnDyerChanged">
                        @foreach (var d in _dyers)
                        {
                            <MudSelectItem Value="@d.Id">@d.Name</MudSelectItem>
                        }
                    </MudSelect>

                    <MudSelect T="string" @ref="_issueRefField" Label="Issue Reference No" Value="_receive.IssueReferenceNo" Variant="Variant.Outlined" Class="mb-4 text-slate-200" Placeholder="Select Issue Reference" ValueChanged="OnIssueReferenceChanged" @onkeydown="OnIssueRefKeyDown">
                        @foreach (var refNo in _dyeingIssueRefs)
                        {
                            <MudSelectItem Value="@refNo">@refNo</MudSelectItem>
                        }
                    </MudSelect>

                    <MudNumericField T="decimal" @ref="_wastePercentField" Label="Waste Percentage (%)" Value="_receive.WastePercentage" ValueChanged="OnWastePercentageChanged" Min="0" Max="100" Format="F2" Variant="Variant.Outlined" Class="mb-4 text-slate-200" @onkeydown="OnWastePercentKeyDown" />

                    <MudCheckBox T="bool" Label="Allow Manual Waste Weight" Value="_receive.AllowManualWaste" ValueChanged="OnAllowManualWasteChanged" Color="Color.Primary" Class="mb-2 text-slate-200" />
                </MudPaper>

                <!-- Actions -->
                <MudPaper Class="glass-panel pa-4 d-flex justify-between">
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="ResetForm">
                        Reset
                    </MudButton>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Save" Disabled="@(!_lineItems.Any() || _saving)" Style="font-family: 'Outfit'; font-weight: 600;">
                        @if (_saving)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        }
                        else
                        {
                            <MudText>Save Receive</MudText>
                        }
                    </MudButton>
                </MudPaper>
            </MudItem>

            <!-- Line Items Grid -->
            <MudItem xs="12" md="8">
                <MudPaper Class="glass-panel pa-6 mb-4">
                    <div class="d-flex justify-between align-center mb-4">
                        <MudText Typo="Typo.h6" Class="text-slate-200" Style="font-family: 'Outfit';">
                            <MudIcon Icon="@Icons.Material.Filled.List" Class="mr-2" /> Receipt Details
                        </MudText>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddRow" Size="Size.Small">
                            Add Row
                        </MudButton>
                    </div>

                    @if (!_lineItems.Any())
                    {
                        <div class="d-flex flex-column align-center justify-center py-8 text-center text-slate-500">
                            <MudIcon Icon="@Icons.Material.Filled.AssignmentReturned" Size="Size.Large" Class="mb-2" />
                            <MudText>No items added yet. Click "Add Row" above.</MudText>
                        </div>
                    }
                    else
                    {
                        <div style="overflow-x: auto;">
                            <table class="w-100 mud-table" style="border-collapse: collapse;">
                                <thead>
                                    <tr style="border-bottom: 1px solid rgba(255,255,255,0.08);">
                                        <th style="color: #94A3B8; padding: 8px; text-align: left; width: 90px;">Yarn Type</th>
                                        <th style="color: #94A3B8; padding: 8px; text-align: left; width: 160px;">Warp/Weft Type</th>
                                        <th style="color: #94A3B8; padding: 8px; text-align: left; width: 100px;">Color</th>
                                        <th style="color: #94A3B8; padding: 8px; text-align: right; width: 90px;">Issued Qty</th>
                                        <th style="color: #94A3B8; padding: 8px; text-align: right; width: 90px;">Issued Wt</th>
                                        <th style="color: #94A3B8; padding: 8px; text-align: right; width: 80px;">Rate</th>
                                        <th style="color: #94A3B8; padding: 8px; text-align: right; width: 100px;">Qty Received</th>
                                        <th style="color: #94A3B8; padding: 8px; text-align: right; width: 100px;">Waste Wt (Kg)</th>
                                        <th style="color: #94A3B8; padding: 8px; text-align: right; width: 110px;">Wt Received (Kg)</th>
                                        <th style="color: #94A3B8; padding: 8px; text-align: center; width: 40px;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < _lineItems.Count; i++)
                                    {
                                        var index = i;
                                        var line = _lineItems[index];
                                        <tr style="border-bottom: 1px solid rgba(255,255,255,0.05); vertical-align: middle;">
                                            <td style="padding: 4px; color: white;">
                                                @if (string.IsNullOrEmpty(_receive.IssueReferenceNo))
                                                {
                                                    <MudSelect T="string" Value="line.YarnType" ValueChanged="@((string val) => OnYarnTypeChanged(index, val))" Margin="Margin.Dense" Variant="Variant.Outlined" Style="color: white; min-width: 90px;">
                                                        <MudSelectItem Value="@("Warp")">Warp</MudSelectItem>
                                                        <MudSelectItem Value="@("Weft")">Weft</MudSelectItem>
                                                    </MudSelect>
                                                }
                                                else
                                                {
                                                    <span>@line.YarnType</span>
                                                }
                                            </td>
                                            <td style="padding: 4px; color: white;">
                                                @if (string.IsNullOrEmpty(_receive.IssueReferenceNo))
                                                {
                                                    @if (line.YarnType == "Warp")
                                                    {
                                                        <MudSelect T="Guid?" @bind-Value="line.WarpTypeId" Margin="Margin.Dense" Variant="Variant.Outlined" Style="color: white; min-width: 150px;">
                                                            @foreach (var wt in _warpTypes)
                                                            {
                                                                <MudSelectItem Value="@((Guid?)wt.Id)">@wt.WarpType</MudSelectItem>
                                                            }
                                                        </MudSelect>
                                                    }
                                                    else
                                                    {
                                                        <MudSelect T="Guid?" @bind-Value="line.WeftTypeId" Margin="Margin.Dense" Variant="Variant.Outlined" Style="color: white; min-width: 150px;">
                                                            @foreach (var wt in _weftTypes)
                                                            {
                                                                <MudSelectItem Value="@((Guid?)wt.Id)">@wt.WeftType</MudSelectItem>
                                                            }
                                                        </MudSelect>
                                                    }
                                                }
                                                else
                                                {
                                                    <span>@(line.YarnType == "Warp" ? _warpTypes.FirstOrDefault(w => w.Id == line.WarpTypeId)?.WarpType : _weftTypes.FirstOrDefault(w => w.Id == line.WeftTypeId)?.WeftType)</span>
                                                }
                                            </td>
                                            <td style="padding: 4px; color: white;">
                                                @if (string.IsNullOrEmpty(_receive.IssueReferenceNo))
                                                {
                                                    <MudTextField T="string" @bind-Value="line.DyedColor" Margin="Margin.Dense" Variant="Variant.Outlined" Style="color: white; min-width: 90px;" />
                                                }
                                                else
                                                {
                                                    <span>@line.DyedColor</span>
                                                }
                                            </td>
                                            <td style="padding: 4px; text-align: right; color: #94A3B8;">
                                                @(line.IssuedQty > 0 ? line.IssuedQty.ToString("N2") : "-")
                                            </td>
                                            <td style="padding: 4px; text-align: right; color: #94A3B8;">
                                                @(line.IssuedWeight > 0 ? line.IssuedWeight.ToString("F3") : "-")
                                            </td>
                                            <td style="padding: 4px; text-align: right; color: #94A3B8;">
                                                @(line.Rate > 0 ? $"₹{line.Rate:N2}" : "-")
                                            </td>
                                            <td style="padding: 4px;">
                                                <MudNumericField @ref="_qtyReceivedRefs[line.Id]" T="decimal" @bind-Value="line.QtyReceived" Min="0" HideSpinButtons="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="color: white; text-align: right; min-width: 80px;" />
                                            </td>
                                            <td style="padding: 4px;">
                                                <MudNumericField T="decimal" Value="line.WasteWeight" ValueChanged="@((decimal val) => OnWasteWeightChanged(line, val))" Min="0" ReadOnly="!_receive.AllowManualWaste" HideSpinButtons="true" Format="F3" Margin="Margin.Dense" Variant="Variant.Outlined" Style="color: white; text-align: right; min-width: 80px;" />
                                            </td>
                                            <td style="padding: 4px;">
                                                <MudNumericField T="decimal" @bind-Value="line.WeightReceived" ReadOnly="true" HideSpinButtons="true" Format="F3" Margin="Margin.Dense" Variant="Variant.Outlined" Style="color: white; text-align: right; min-width: 80px;" />
                                            </td>
                                            <td style="padding: 4px; text-align: center;">
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveRow(index))" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    </EditForm>
</MudContainer>

@code {
    private List<JobWorkMaster> _dyers = new();
    private List<WarpTypeMaster> _warpTypes = new();
    private List<WeftTypeMaster> _weftTypes = new();
    private List<string> _dyeingIssueRefs = new();
    private List<DyeingIssue> _allIssues = new();

    private DyeingReceive _receive = new();
    private DateTime? _receiveDate = DateTime.Today;
    private List<DyeingReceiveDetail> _lineItems = new();
    
    // Focus and shortcuts helpers
    private MudSelect<string>? _issueRefField;
    private MudNumericField<decimal>? _wastePercentField;
    private Dictionary<Guid, MudNumericField<decimal>> _qtyReceivedRefs = new();
    private DotNetObjectReference<DyeingReceivePage>? _dotNetRef;
    private bool _saving = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadLookups();
        ResetForm();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("shortcutInterop.registerSaveShortcut", _dotNetRef);
        }
    }

    [JSInvokable]
    public async Task TriggerSaveFromShortcut()
    {
        if (!_saving && _lineItems.Any())
        {
            await SaveReceive();
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        _dotNetRef?.Dispose();
        _ = JSRuntime.InvokeVoidAsync("shortcutInterop.unregisterSaveShortcut");
    }

    private async Task LoadLookups()
    {
        try
        {
            var workers = await Http.GetFromJsonAsync<List<JobWorkMaster>>("api/jobwork/workers") ?? new();
            _dyers = workers.Where(w => w.Type == "Dyer" && w.Active).ToList();

            var warps = await Http.GetFromJsonAsync<List<WarpTypeMaster>>("api/masters/warptypes") ?? new();
            _warpTypes = warps.Where(w => w.Active).ToList();

            var wefts = await Http.GetFromJsonAsync<List<WeftTypeMaster>>("api/masters/wefttypes") ?? new();
            _weftTypes = wefts.Where(w => w.Active).ToList();
            
            _allIssues = await Http.GetFromJsonAsync<List<DyeingIssue>>("api/jobwork/dyeing/issues") ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading lookups: {ex.Message}", Severity.Error);
        }
    }

    private void OnDyerChanged(Guid dyerId)
    {
        _receive.DyerId = dyerId;
        
        // Auto default Dyer waste percentage
        var dyer = _dyers.FirstOrDefault(d => d.Id == dyerId);
        _receive.WastePercentage = dyer?.WastePercentage ?? 0;

        _dyeingIssueRefs = _allIssues
            .Where(i => i.DyerId == dyerId)
            .Select(i => i.IssueNo)
            .Distinct()
            .ToList();
        
        var firstRef = _dyeingIssueRefs.FirstOrDefault() ?? string.Empty;
        OnIssueReferenceChanged(firstRef);
    }

    private void OnIssueReferenceChanged(string refNo)
    {
        _receive.IssueReferenceNo = refNo;
        
        if (string.IsNullOrEmpty(refNo))
        {
            _receive.DyeingIssueId = null;
            _lineItems.Clear();
            _qtyReceivedRefs.Clear();
            AddRow();
            return;
        }

        var issue = _allIssues.FirstOrDefault(i => i.IssueNo == refNo && i.DyerId == _receive.DyerId);
        if (issue != null)
        {
            _receive.DyeingIssueId = issue.Id;
            if (issue.Details != null && issue.Details.Any())
            {
                _lineItems.Clear();
                _qtyReceivedRefs.Clear();
                foreach (var detail in issue.Details)
                {
                    var line = new DyeingReceiveDetail
                    {
                        YarnType = detail.YarnType,
                        WarpTypeId = detail.WarpTypeId,
                        WeftTypeId = detail.WeftTypeId,
                        DyedColor = detail.Color,
                        IssuedQty = detail.Qty,
                        IssuedWeight = detail.WeightKgs,
                        Rate = detail.Rate,
                        QtyReceived = detail.Qty,
                        WasteWeight = 0,
                        WeightReceived = detail.WeightKgs
                    };
                    _lineItems.Add(line);
                    RecalculateRow(line);
                }
            }
            else
            {
                _lineItems.Clear();
                _qtyReceivedRefs.Clear();
                AddRow();
            }
        }
        else
        {
            _receive.DyeingIssueId = null;
            _lineItems.Clear();
            _qtyReceivedRefs.Clear();
            AddRow();
        }
    }

    private void OnWastePercentageChanged(decimal val)
    {
        _receive.WastePercentage = val;
        RecalculateAllRows();
    }

    private void OnAllowManualWasteChanged(bool val)
    {
        _receive.AllowManualWaste = val;
        RecalculateAllRows();
    }

    private void OnWasteWeightChanged(DyeingReceiveDetail line, decimal val)
    {
        line.WasteWeight = val;
        RecalculateRow(line);
    }

    private void RecalculateAllRows()
    {
        foreach (var line in _lineItems)
        {
            RecalculateRow(line);
        }
    }

    private void RecalculateRow(DyeingReceiveDetail line)
    {
        if (!_receive.AllowManualWaste)
        {
            line.WasteWeight = Math.Round(line.IssuedWeight * _receive.WastePercentage / 100m, 3);
            line.WeightReceived = Math.Round(line.IssuedWeight - line.WasteWeight, 3);
        }
        else
        {
            line.WeightReceived = Math.Round(line.IssuedWeight - line.WasteWeight, 3);
        }
    }

    private async Task OnIssueRefKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            if (_wastePercentField != null)
            {
                await _wastePercentField.FocusAsync();
            }
        }
    }

    private async Task OnWastePercentKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            RecalculateAllRows();
            var firstLine = _lineItems.FirstOrDefault();
            if (firstLine != null)
            {
                await Task.Delay(50);
                if (_qtyReceivedRefs.TryGetValue(firstLine.Id, out var refObj) && refObj != null)
                {
                    await refObj.FocusAsync();
                }
            }
        }
    }

    private void ResetForm()
    {
        _receive = new DyeingReceive
        {
            ReceiveDate = DateTimeOffset.UtcNow,
            DyerId = _dyers.FirstOrDefault()?.Id ?? Guid.Empty,
            ReceiveNo = "Auto",
            WastePercentage = 0,
            AllowManualWaste = false
        };
        _receiveDate = DateTime.Today;
        _lineItems.Clear();
        _qtyReceivedRefs.Clear();

        if (_receive.DyerId != Guid.Empty)
        {
            OnDyerChanged(_receive.DyerId);
        }
        else
        {
            AddRow();
        }
    }

    private void AddRow()
    {
        _lineItems.Add(new DyeingReceiveDetail
        {
            YarnType = "Warp",
            WarpTypeId = _warpTypes.FirstOrDefault()?.Id,
            QtyReceived = 1,
            WeightReceived = 1,
            WasteWeight = 0,
            IssuedQty = 0,
            IssuedWeight = 0,
            Rate = 0
        });
    }

    private void OnYarnTypeChanged(int index, string val)
    {
        var line = _lineItems[index];
        line.YarnType = val;
        if (val == "Warp")
        {
            line.WarpTypeId = _warpTypes.FirstOrDefault()?.Id;
            line.WeftTypeId = null;
        }
        else
        {
            line.WeftTypeId = _weftTypes.FirstOrDefault()?.Id;
            line.WarpTypeId = null;
        }
    }

    private void RemoveRow(int index)
    {
        if (index >= 0 && index < _lineItems.Count)
        {
            _lineItems.RemoveAt(index);
        }
    }

    private async Task SaveReceive()
    {
        if (!_lineItems.Any())
        {
            Snackbar.Add("Please add at least one receipt row.", Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            _receive.ReceiveDate = _receiveDate ?? DateTimeOffset.UtcNow;
            _receive.Details = _lineItems.Select(l => new DyeingReceiveDetail
            {
                YarnType = l.YarnType,
                WarpTypeId = l.WarpTypeId,
                WeftTypeId = l.WeftTypeId,
                DyedColor = l.DyedColor,
                QtyReceived = l.QtyReceived,
                WeightReceived = l.WeightReceived,
                WasteWeight = l.WasteWeight,
                IssuedQty = l.IssuedQty,
                IssuedWeight = l.IssuedWeight,
                Rate = l.Rate
            }).ToList();

            var response = await Http.PostAsJsonAsync("api/jobwork/dyeing/receives", _receive);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Dyeing receive saved successfully! Dyed yarn stock credited.", Severity.Success);
                ResetForm();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Save failed: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
