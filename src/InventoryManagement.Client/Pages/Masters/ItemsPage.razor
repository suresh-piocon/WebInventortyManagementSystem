@page "/masters/items"
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Item Master - Inventory Management</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-2">
    <div class="d-flex justify-between align-center mb-6">
        <div>
            <MudText Typo="Typo.h4" Class="font-weight-bold animated-gradient-text" Style="font-family: 'Outfit';">
                Item Master
            </MudText>
            <MudText Typo="Typo.body2" Class="text-slate-400">
                Configure item specifications, reorder levels, and tracking configurations
            </MudText>
        </div>
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Primary" 
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenAddDialog"
                   Style="background: linear-gradient(135deg, #5C5CFF 0%, #00E5FF 100%); font-family: 'Outfit'; font-weight: 600;">
            Add Item
        </MudButton>
    </div>

    <MudTable Items="@_items" 
              Hover="true" 
              Loading="@_loading" 
              SearchString="@_searchString" 
              Filter="new Func<Item, bool>(FilterFunc)"
              Class="glass-panel text-slate-200">
        <ToolBarContent>
            <MudText Typo="Typo.h6" Style="font-family: 'Outfit'; color: #E2E8F0;">Items list</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="_searchString" 
                          Placeholder="Search items..." 
                          Adornment="Adornment.Start" 
                          AdornmentIcon="@Icons.Material.Filled.Search" 
                          IconSize="Size.Medium" 
                          Class="mt-0 text-slate-200" 
                          Style="color: white;"/>
        </ToolBarContent>
        <HeaderContent>
            <MudTh Style="color: #94A3B8;">Code</MudTh>
            <MudTh Style="color: #94A3B8;">Item Name</MudTh>
            <MudTh Style="color: #94A3B8;">Category</MudTh>
            <MudTh Style="color: #94A3B8;">Brand</MudTh>
            <MudTh Style="color: #94A3B8;">Unit</MudTh>
            <MudTh Style="color: #94A3B8;">Min Stock</MudTh>
            <MudTh Style="color: #94A3B8;">Reorder Level</MudTh>
            <MudTh Style="color: #94A3B8;">GST %</MudTh>
            <MudTh Style="color: #94A3B8;">Tracking Type</MudTh>
            <MudTh Style="color: #94A3B8; text-align: right;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Code" Class="text-slate-100 font-weight-bold">@context.Code</MudTd>
            <MudTd DataLabel="Item Name" Class="text-slate-200 font-weight-bold">@context.Name</MudTd>
            <MudTd DataLabel="Category" Class="text-slate-300">@context.Category?.Name</MudTd>
            <MudTd DataLabel="Brand" Class="text-slate-300">@context.Brand</MudTd>
            <MudTd DataLabel="Unit" Class="text-slate-300">@context.Unit?.Code</MudTd>
            <MudTd DataLabel="Min Stock" Class="text-slate-300">@context.MinimumStock.ToString("N2")</MudTd>
            <MudTd DataLabel="Reorder Level" Class="text-slate-300">@context.ReorderLevel.ToString("N2")</MudTd>
            <MudTd DataLabel="GST %" Class="text-slate-300">@context.GSTPercent.ToString("N2")%</MudTd>
            <MudTd DataLabel="Tracking Type">
                @if (context.BarcodeType == "Unique")
                {
                    <MudChip T="string" Color="Color.Secondary" Size="Size.Small" Variant="Variant.Text">Unique Piece</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Text">Batch Quantity</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Actions" Style="text-align: right;">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" Size="Size.Small" OnClick="@(() => OpenEditDialog(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => ConfirmDelete(context))" />
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
</MudContainer>

<!-- Dialog for Add/Edit -->
<MudDialog @bind-Visible="_dialogOpen" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6" Style="font-family: 'Outfit'; color: white;">
            @(_editItem.Id == Guid.Empty ? "Create New Design" : "Edit Design")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_isFormValid">
            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudTextField T="string" Label="Design Code" @bind-Value="_editItem.Code" Required="true" RequiredError="Design code is required" Class="text-slate-200" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField T="string" Label="Design Name" @bind-Value="_editItem.Name" Required="true" RequiredError="Design name is required" Class="text-slate-200" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal" Label="Wages (₹)" @bind-Value="_editItem.Wages" Min="0" Class="text-slate-200" Format="F2" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="Guid" Label="Category" @bind-Value="_editItem.CategoryId" Required="true" RequiredError="Category is required" Class="text-slate-200">
                        @foreach (var cat in _categories)
                        {
                            <MudSelectItem Value="@cat.Id">@cat.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="Guid" Label="Unit of Measure" @bind-Value="_editItem.UnitId" Required="true" RequiredError="Unit is required" Class="text-slate-200">
                        @foreach (var unit in _units)
                        {
                            <MudSelectItem Value="@unit.Id">@unit.Code - @unit.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudSelect T="Guid?" Label="Warp Type" Value="_editItem.WarpTypeId" Class="text-slate-200" ValueChanged="OnWarpTypeChanged" Variant="Variant.Text">
                        <MudSelectItem T="Guid?" Value="@((Guid?)null)">[Select Warp Type]</MudSelectItem>
                        @foreach (var w in _warpTypes)
                        {
                            <MudSelectItem T="Guid?" Value="@((Guid?)w.Id)">@w.WarpType</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="Guid?" Label="Weft Type" Value="_editItem.WeftTypeId" Class="text-slate-200" ValueChanged="OnWeftTypeChanged" Variant="Variant.Text">
                        <MudSelectItem T="Guid?" Value="@((Guid?)null)">[Select Weft Type]</MudSelectItem>
                        @foreach (var w in _weftTypes)
                        {
                            <MudSelectItem T="Guid?" Value="@((Guid?)w.Id)">@w.WeftType</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField T="string" Label="Brand Name" @bind-Value="_editItem.Brand" Class="text-slate-200" />
                </MudItem>

                <MudItem xs="12" sm="3">
                    <MudNumericField T="decimal" Label="Warp Weight (Kgs)" Value="_editItem.WarpWeight" Min="0" Class="text-slate-200" Format="F3" ValueChanged="OnWarpWeightChanged" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudNumericField T="decimal" Label="Weft Weight (Kgs)" Value="_editItem.WeftWeight" Min="0" Class="text-slate-200" Format="F3" ValueChanged="OnWeftWeightChanged" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudNumericField T="decimal" Label="Zari Weight (Kgs)" Value="_editItem.ZariWeight" Min="0" Class="text-slate-200" Format="F3" ValueChanged="OnZariWeightChanged" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudNumericField T="decimal" Label="Total Weight (Kgs)" @bind-Value="_editItem.TotalWeight" Disabled="true" Class="text-slate-200" Format="F3" />
                </MudItem>

                <MudItem xs="12" sm="3">
                    <MudTextField T="string" Label="Reed" @bind-Value="_editItem.Reed" Class="text-slate-200" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudTextField T="string" Label="Thread" @bind-Value="_editItem.Thread" Class="text-slate-200" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudNumericField T="int" Label="No of Cards" @bind-Value="_editItem.NoOfCards" Min="0" Class="text-slate-200" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudNumericField T="int" Label="No of Marks" @bind-Value="_editItem.NoOfMarks" Min="0" Class="text-slate-200" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField T="string" Label="Body Image URL" @bind-Value="_editItem.BodyImage" Class="text-slate-200" />
                    @if (!string.IsNullOrEmpty(_editItem.BodyImage))
                    {
                        <div class="mt-2 text-center" style="border: 1px solid rgba(255,255,255,0.08); border-radius: 8px; padding: 4px; background: rgba(0,0,0,0.2);">
                            <img src="@_editItem.BodyImage" style="max-height: 80px; max-width: 100%; border-radius: 4px;" alt="Body Image" />
                        </div>
                    }
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField T="string" Label="Pallu Image URL" @bind-Value="_editItem.PalluImage" Class="text-slate-200" />
                    @if (!string.IsNullOrEmpty(_editItem.PalluImage))
                    {
                        <div class="mt-2 text-center" style="border: 1px solid rgba(255,255,255,0.08); border-radius: 8px; padding: 4px; background: rgba(0,0,0,0.2);">
                            <img src="@_editItem.PalluImage" style="max-height: 80px; max-width: 100%; border-radius: 4px;" alt="Pallu Image" />
                        </div>
                    }
                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudTextField T="string" Label="HSN Code" @bind-Value="_editItem.HSNCode" Class="text-slate-200" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal" Label="GST %" @bind-Value="_editItem.GSTPercent" Min="0" Max="100" Class="text-slate-200" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="string" Label="Barcode Tracking Type" @bind-Value="_editItem.BarcodeType" Required="true" Class="text-slate-200">
                        <MudSelectItem Value="@("Batch")">Batch Barcode (One per Batch)</MudSelectItem>
                        <MudSelectItem Value="@("Unique")">Unique Barcode (One per Piece)</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseDialog" Variant="Variant.Text" Color="Color.Secondary">Cancel</MudButton>
        <MudButton OnClick="SaveItem" Variant="Variant.Filled" Color="Color.Primary" Disabled="@_saving">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
            }
            else
            {
                <MudText>Save</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<Item> _items = new();
    private List<Category> _categories = new();
    private List<Unit> _units = new();
    private List<WarpTypeMaster> _warpTypes = new();
    private List<WeftTypeMaster> _weftTypes = new();
    private bool _loading = true;
    private bool _saving = false;
    private string _searchString = "";

    // Dialog state
    private bool _dialogOpen = false;
    private bool _isFormValid = false;
    private MudForm? _form;
    private Item _editItem = new();
    private readonly DialogOptions _dialogOptions = new() { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };

    protected override async Task OnInitializedAsync()
    {
        await LoadDropdowns();
        await LoadItems();
    }

    private async Task LoadDropdowns()
    {
        try
        {
            _categories = await Http.GetFromJsonAsync<List<Category>>("api/masters/categories") ?? new();
            _units = await Http.GetFromJsonAsync<List<Unit>>("api/masters/units") ?? new();
            
            var warps = await Http.GetFromJsonAsync<List<WarpTypeMaster>>("api/masters/warptypes") ?? new();
            _warpTypes = warps.Where(w => w.Active).ToList();

            var wefts = await Http.GetFromJsonAsync<List<WeftTypeMaster>>("api/masters/wefttypes") ?? new();
            _weftTypes = wefts.Where(w => w.Active).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading lookup details: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadItems()
    {
        _loading = true;
        try
        {
            _items = await Http.GetFromJsonAsync<List<Item>>("api/masters/items") ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading items: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private bool FilterFunc(Item element) => 
        string.IsNullOrWhiteSpace(_searchString) || 
        element.Code.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
        element.Name.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
        (element.Category != null && element.Category.Name.Contains(_searchString, StringComparison.OrdinalIgnoreCase)) ||
        (element.Brand != null && element.Brand.Contains(_searchString, StringComparison.OrdinalIgnoreCase));

    private void OpenAddDialog()
    {
        _editItem = new Item
        {
            Id = Guid.Empty,
            BarcodeType = "Batch",
            GSTPercent = 18.00M,
            CategoryId = _categories.FirstOrDefault()?.Id ?? Guid.Empty,
            UnitId = _units.FirstOrDefault()?.Id ?? Guid.Empty
        };
        _dialogOpen = true;
    }

    private void OpenEditDialog(Item item)
    {
        _editItem = new Item
        {
            Id = item.Id,
            Code = item.Code,
            Name = item.Name,
            CategoryId = item.CategoryId,
            UnitId = item.UnitId,
            Brand = item.Brand,
            HSNCode = item.HSNCode,
            GSTPercent = item.GSTPercent,
            MinimumStock = item.MinimumStock,
            ReorderLevel = item.ReorderLevel,
            BarcodeType = item.BarcodeType,
            WarpTypeId = item.WarpTypeId,
            WeftTypeId = item.WeftTypeId,
            WarpType = item.WarpType,
            WeftType = item.WeftType,
            Wages = item.Wages,
            WarpWeight = item.WarpWeight,
            WeftWeight = item.WeftWeight,
            ZariWeight = item.ZariWeight,
            TotalWeight = item.TotalWeight,
            Reed = item.Reed,
            Thread = item.Thread,
            NoOfCards = item.NoOfCards,
            NoOfMarks = item.NoOfMarks,
            BodyImage = item.BodyImage,
            PalluImage = item.PalluImage,
            CreatedAt = item.CreatedAt
        };
        _dialogOpen = true;
    }

    private void CloseDialog()
    {
        _dialogOpen = false;
    }

    private async Task SaveItem()
    {
        if (_form == null) return;
        await _form.Validate();
        if (!_form.IsValid) return;

        _saving = true;
        try
        {
            HttpResponseMessage response;
            if (_editItem.Id == Guid.Empty)
            {
                response = await Http.PostAsJsonAsync("api/masters/items", _editItem);
            }
            else
            {
                response = await Http.PutAsJsonAsync($"api/masters/items/{_editItem.Id}", _editItem);
            }

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Item details saved successfully!", Severity.Success);
                _dialogOpen = false;
                await LoadItems();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Save failed: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private void OnWarpWeightChanged(decimal val)
    {
        _editItem.WarpWeight = val;
        RecalculateTotalWeight();
    }

    private void OnWeftWeightChanged(decimal val)
    {
        _editItem.WeftWeight = val;
        RecalculateTotalWeight();
    }

    private void OnZariWeightChanged(decimal val)
    {
        _editItem.ZariWeight = val;
        RecalculateTotalWeight();
    }

    private void RecalculateTotalWeight()
    {
        _editItem.TotalWeight = _editItem.WarpWeight + _editItem.WeftWeight + _editItem.ZariWeight;
    }

    private void OnWarpTypeChanged(Guid? id)
    {
        _editItem.WarpTypeId = id;
        var spec = _warpTypes.FirstOrDefault(w => w.Id == id);
        _editItem.WarpType = spec?.WarpType;
    }

    private void OnWeftTypeChanged(Guid? id)
    {
        _editItem.WeftTypeId = id;
        var spec = _weftTypes.FirstOrDefault(w => w.Id == id);
        _editItem.WeftType = spec?.WeftType;
    }

    private async Task ConfirmDelete(Item item)
    {
        bool? confirm = await DialogService.ShowMessageBoxAsync(
            "Delete Item", 
            $"Are you sure you want to delete item '{item.Name}'?", 
            yesText: "Delete", cancelText: "Cancel");

        if (confirm == true)
        {
            try
            {
                var response = await Http.DeleteAsync($"api/masters/items/{item.Id}");
                if (response.IsSuccessStatusCode)
                {
                    Snackbar.Add("Item deleted successfully!", Severity.Success);
                    await LoadItems();
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    Snackbar.Add($"Delete failed: {error}", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error deleting: {ex.Message}", Severity.Error);
            }
        }
    }
}
