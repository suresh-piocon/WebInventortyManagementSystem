@page "/masters/warptypes"
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Warp Type Master - Inventory Management</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-2">
    <div class="d-flex justify-between align-center mb-6">
        <div>
            <MudText Typo="Typo.h4" Class="font-weight-bold animated-gradient-text" Style="font-family: 'Outfit';">
                Warp Type Master
            </MudText>
            <MudText Typo="Typo.body2" Class="text-slate-400">
                Maintain all standard warp constructions used in designs
            </MudText>
        </div>
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Primary" 
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenAddDialog"
                   Style="background: linear-gradient(135deg, #5C5CFF 0%, #00E5FF 100%); font-family: 'Outfit'; font-weight: 600;">
            Add Warp Type
        </MudButton>
    </div>

    <MudTable Items="@_warpTypes" 
              Hover="true" 
              Loading="@_loading" 
              SearchString="@_searchString" 
              Filter="new Func<WarpTypeMaster, bool>(FilterFunc)"
              Class="glass-panel text-slate-200">
        <ToolBarContent>
            <MudText Typo="Typo.h6" Style="font-family: 'Outfit'; color: #E2E8F0;">Warp Types</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="_searchString" 
                           Placeholder="Search warp constructions..." 
                           Adornment="Adornment.Start" 
                           AdornmentIcon="@Icons.Material.Filled.Search" 
                           IconSize="Size.Medium" 
                           Class="mt-0 text-slate-200" 
                           Style="color: white;"/>
        </ToolBarContent>
        <HeaderContent>
            <MudTh Style="color: #94A3B8;">Code</MudTh>
            <MudTh Style="color: #94A3B8;">Warp Type</MudTh>
            <MudTh Style="color: #94A3B8; text-align: right;">Ends Count</MudTh>
            <MudTh Style="color: #94A3B8; text-align: right;">Yarn Count</MudTh>
            <MudTh Style="color: #94A3B8;">Description</MudTh>
            <MudTh Style="color: #94A3B8;">Status</MudTh>
            <MudTh Style="color: #94A3B8; text-align: right; width: 120px;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Code" Class="text-slate-100 font-mono">@context.Code</MudTd>
            <MudTd DataLabel="Warp Type" Class="text-slate-100 font-weight-bold">@context.WarpType</MudTd>
            <MudTd DataLabel="Ends Count" Class="text-slate-200" Style="text-align: right;">@context.EndsCount.ToString("N0")</MudTd>
            <MudTd DataLabel="Yarn Count" Class="text-slate-200" Style="text-align: right;">@context.YarnCount.ToString("N0")</MudTd>
            <MudTd DataLabel="Description" Class="text-slate-300">@(string.IsNullOrEmpty(context.Description) ? "N/A" : context.Description)</MudTd>
            <MudTd DataLabel="Status">
                @if (context.Active)
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small">Active</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Error" Size="Size.Small">Inactive</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Actions" Style="text-align: right;">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" Size="Size.Small" OnClick="@(() => OpenEditDialog(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => ConfirmDelete(context))" />
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
</MudContainer>

<!-- Dialog for Add/Edit -->
<MudDialog @bind-Visible="_dialogOpen" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6" Style="font-family: 'Outfit'; color: white;">
            @(_editType.Id == Guid.Empty ? "Create New Warp Type" : "Edit Warp Type")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_isFormValid">
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField T="string" Label="Warp Type Code" @bind-Value="_editType.Code" Required="true" RequiredError="Code is required" Class="text-slate-200" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField T="string" Label="Warp Type (e.g. 40*7800)" @bind-Value="_editType.WarpType" Required="true" RequiredError="Warp construction formula is required" Class="text-slate-200" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField T="int" Label="Ends Count" @bind-Value="_editType.EndsCount" Required="true" Min="1" Class="text-slate-200" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField T="int" Label="Yarn Count" @bind-Value="_editType.YarnCount" Required="true" Min="1" Class="text-slate-200" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" Label="Description" @bind-Value="_editType.Description" Class="text-slate-200" />
                </MudItem>
                <MudItem xs="12">
                    <MudSwitch T="bool" Label="Active" @bind-Value="_editType.Active" Color="Color.Success" Class="text-slate-200" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseDialog" Variant="Variant.Text" Color="Color.Secondary">Cancel</MudButton>
        <MudButton OnClick="SaveWarpType" Variant="Variant.Filled" Color="Color.Primary" Disabled="@_saving">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
            }
            else
            {
                <MudText>Save</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<WarpTypeMaster> _warpTypes = new();
    private string _searchString = "";
    private bool _loading = true;
    private bool _saving = false;

    private bool _dialogOpen = false;
    private bool _isFormValid = false;
    private MudForm? _form;
    private WarpTypeMaster _editType = new();

    private readonly DialogOptions _dialogOptions = new() { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };

    protected override async Task OnInitializedAsync()
    {
        await LoadWarpTypes();
    }

    private async Task LoadWarpTypes()
    {
        _loading = true;
        try
        {
            _warpTypes = await Http.GetFromJsonAsync<List<WarpTypeMaster>>("api/masters/warptypes") ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading warp types: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private bool FilterFunc(WarpTypeMaster element) =>
        string.IsNullOrWhiteSpace(_searchString) ||
        element.Code.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
        element.WarpType.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
        (element.Description != null && element.Description.Contains(_searchString, StringComparison.OrdinalIgnoreCase));

    private void OpenAddDialog()
    {
        _editType = new WarpTypeMaster
        {
            Id = Guid.Empty,
            Code = $"W{(_warpTypes.Count + 1):D4}",
            WarpType = "",
            EndsCount = 7800,
            YarnCount = 40,
            Active = true
        };
        _dialogOpen = true;
    }

    private void OpenEditDialog(WarpTypeMaster type)
    {
        _editType = new WarpTypeMaster
        {
            Id = type.Id,
            Code = type.Code,
            WarpType = type.WarpType,
            EndsCount = type.EndsCount,
            YarnCount = type.YarnCount,
            Description = type.Description,
            Active = type.Active,
            CreatedAt = type.CreatedAt
        };
        _dialogOpen = true;
    }

    private void CloseDialog()
    {
        _dialogOpen = false;
    }

    private async Task SaveWarpType()
    {
        if (_form == null) return;
        await _form.Validate();
        if (!_form.IsValid) return;

        _saving = true;
        try
        {
            HttpResponseMessage response;
            if (_editType.Id == Guid.Empty)
            {
                response = await Http.PostAsJsonAsync("api/masters/warptypes", _editType);
            }
            else
            {
                response = await Http.PutAsJsonAsync($"api/masters/warptypes/{_editType.Id}", _editType);
            }

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Warp type saved successfully!", Severity.Success);
                _dialogOpen = false;
                await LoadWarpTypes();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Save failed: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving warp type: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ConfirmDelete(WarpTypeMaster type)
    {
        bool? confirm = await DialogService.ShowMessageBoxAsync(
            "Confirm Delete", 
            $"Are you sure you want to delete warp type '{type.WarpType}'?", 
            yesText: "Delete", cancelText: "Cancel");

        if (confirm == true)
        {
            try
            {
                var response = await Http.DeleteAsync($"api/masters/warptypes/{type.Id}");
                if (response.IsSuccessStatusCode)
                {
                    Snackbar.Add("Warp type deleted successfully!", Severity.Success);
                    await LoadWarpTypes();
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    Snackbar.Add($"Delete failed: {error}", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error deleting warp type: {ex.Message}", Severity.Error);
            }
        }
    }
}
