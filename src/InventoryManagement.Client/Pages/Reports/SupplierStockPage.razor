@page "/reports/supplier-stock"
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime

<PageTitle>Supplier Stock Report - AG Inventory</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-2">
    <div class="d-flex justify-between align-center mb-6">
        <div>
            <MudText Typo="Typo.h4" Class="font-weight-bold animated-gradient-text" Style="font-family: 'Outfit';">
                Supplier Stock Report
            </MudText>
            <MudText Typo="Typo.body2" Class="text-slate-400">
                View current stock balances grouped by supplier, batch codes, and tracking numbers
            </MudText>
        </div>
        <div class="d-flex align-center gap-2">
            <MudSelect T="string" Label="Valuation Mode" Value="@_valuationMethod" ValueChanged="OnValuationChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width: 200px; color: white;">
                <MudSelectItem Value="@("WeightedAverage")">Weighted Average</MudSelectItem>
                <MudSelectItem Value="@("FIFO")">FIFO Method</MudSelectItem>
            </MudSelect>
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Primary" OnClick="LoadReport" />
        </div>
    </div>

    <MudTable Items="@_reportLines" 
              Hover="true" 
              Loading="@_loading" 
              SearchString="@_searchString" 
              Filter="new Func<SupplierStockReportDto, bool>(FilterFunc)"
              Class="glass-panel text-slate-200">
        <ToolBarContent>
            <MudText Typo="Typo.h6" Style="font-family: 'Outfit'; color: #E2E8F0;">Stock Ledger Balances</MudText>
            <MudSpacer />
            
            <MudCheckBox T="bool" 
                         Value="@_showBarcodeDetails" 
                         ValueChanged="OnShowBarcodeDetailsChanged" 
                         Label="Show Detailed Barcode Info (In/Out with Photos)" 
                         Color="Color.Primary" 
                         Class="mt-0 mr-4 text-slate-200" />
            
            <MudTextField @bind-Value="_searchString" 
                          Placeholder="Search by item, supplier, batch..." 
                          Adornment="Adornment.Start" 
                          AdornmentIcon="@Icons.Material.Filled.Search" 
                          IconSize="Size.Medium" 
                          Class="mt-0 mr-4 text-slate-200" 
                          Style="color: white;"/>

            <MudMenu StartIcon="@Icons.Material.Filled.Download" Label="Export Data" Color="Color.Secondary" Variant="Variant.Filled" EndIcon="@Icons.Material.Filled.KeyboardArrowDown">
                <MudMenuItem OnClick="@(() => ExportFile("excel"))" Icon="@Icons.Custom.FileFormats.FileExcel" IconColor="Color.Success">Excel (.xlsx)</MudMenuItem>
                <MudMenuItem OnClick="@(() => ExportFile("csv"))" Icon="@Icons.Material.Filled.TextSnippet" IconColor="Color.Info">CSV (.csv)</MudMenuItem>
            </MudMenu>
        </ToolBarContent>
        <HeaderContent>
            <MudTh Style="color: #94A3B8; text-align: center; width: 60px;">Photo</MudTh>
            <MudTh Style="color: #94A3B8;">Supplier</MudTh>
            <MudTh Style="color: #94A3B8;">Item Name</MudTh>
            <MudTh Style="color: #94A3B8;">Batch No</MudTh>
            <MudTh Style="color: #94A3B8;">Tracking No</MudTh>
            <MudTh Style="color: #94A3B8; text-align: right;">Inward Qty</MudTh>
            <MudTh Style="color: #94A3B8; text-align: right;">Outward Qty</MudTh>
            <MudTh Style="color: #94A3B8; text-align: right;">Balance Qty</MudTh>
            <MudTh Style="color: #94A3B8; text-align: right;">Unit Cost</MudTh>
            <MudTh Style="color: #94A3B8; text-align: right;">Total Value</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Photo" Style="text-align: center;">
                @if (!string.IsNullOrEmpty(context.ImageUrl))
                {
                    <img src="@GetAbsoluteImageUrl(context.ImageUrl)" style="width: 38px; height: 38px; border-radius: 4px; object-fit: cover; border: 1px solid #5C5CFF; cursor: pointer;" @onclick="@(() => PreviewImage(context.ImageUrl))" />
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.ImageNotSupported" Color="Color.Dark" />
                }
            </MudTd>
            <MudTd DataLabel="Supplier" Class="text-slate-200">@context.SupplierName</MudTd>
            <MudTd DataLabel="Item Name" Class="text-slate-100 font-weight-bold">
                @context.ItemName <br/>
                <span class="text-slate-400 font-mono" style="font-size: 11px;">@context.ItemCode</span>
            </MudTd>
            <MudTd DataLabel="Batch No" Class="text-slate-200">@context.BatchNo</MudTd>
            <MudTd DataLabel="Tracking No" Class="text-slate-300 font-mono" Style="font-size: 12px;">@context.TrackingNo</MudTd>
            <MudTd DataLabel="Inward Qty" Style="text-align: right;" Class="text-slate-300">@context.InwardQty.ToString("N2")</MudTd>
            <MudTd DataLabel="Outward Qty" Style="text-align: right;" Class="text-slate-300">@context.OutwardQty.ToString("N2")</MudTd>
            <MudTd DataLabel="Balance Qty" Style="text-align: right;" Class="text-yellow-500 font-weight-bold">@context.BalanceQty.ToString("N2")</MudTd>
            <MudTd DataLabel="Unit Cost" Style="text-align: right;" Class="text-slate-300">₹@context.UnitCost.ToString("N4")</MudTd>
            <MudTd DataLabel="Total Value" Style="text-align: right;" Class="text-slate-100 font-weight-bold">₹@context.Value.ToString("N2")</MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>

    @if (_showBarcodeDetails)
    {
        <MudTable Items="@_barcodeDetails" 
                  Hover="true" 
                  Loading="@_loadingBarcodes" 
                  Class="glass-panel text-slate-200 mt-6">
            <ToolBarContent>
                <MudText Typo="Typo.h6" Style="font-family: 'Outfit'; color: #E2E8F0;">
                    <MudIcon Icon="@Icons.Material.Filled.QrCode" Class="mr-2 text-cyan" /> Detailed Barcode In/Out Logs
                </MudText>
                <MudSpacer />
            </ToolBarContent>
            <HeaderContent>
                <MudTh Style="color: #94A3B8; text-align: center; width: 60px;">Photo</MudTh>
                <MudTh Style="color: #94A3B8;">Item Name</MudTh>
                <MudTh Style="color: #94A3B8;">Barcode No</MudTh>
                <MudTh Style="color: #94A3B8;">Batch No</MudTh>
                <MudTh Style="color: #94A3B8;">Tracking No</MudTh>
                <MudTh Style="color: #94A3B8;">Type</MudTh>
                <MudTh Style="color: #94A3B8;">Inward Date</MudTh>
                <MudTh Style="color: #94A3B8;">Outward Date</MudTh>
                <MudTh Style="color: #94A3B8;">Status</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd Style="text-align: center;">
                    @if (!string.IsNullOrEmpty(context.ImageUrl))
                    {
                        <img src="@GetAbsoluteImageUrl(context.ImageUrl)" style="width: 40px; height: 40px; border-radius: 6px; object-fit: cover; border: 1px solid #5C5CFF; cursor: pointer;" @onclick="@(() => PreviewImage(context.ImageUrl))" />
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.ImageNotSupported" Color="Color.Dark" />
                    }
                </MudTd>
                <MudTd DataLabel="Item Name" Class="text-slate-100 font-weight-bold">@context.ItemName</MudTd>
                <MudTd DataLabel="Barcode No" Class="text-slate-200 font-mono">@context.BarcodeNo</MudTd>
                <MudTd DataLabel="Batch No" Class="text-slate-300">@context.BatchNo</MudTd>
                <MudTd DataLabel="Tracking No" Class="text-slate-400 font-mono" Style="font-size: 11px;">@context.TrackingNo</MudTd>
                <MudTd DataLabel="Type">
                    <MudChip T="string" Color="Color.Default" Size="Size.Small">@context.Type</MudChip>
                </MudTd>
                <MudTd DataLabel="Inward Date" Class="text-slate-300">@context.InwardDate.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</MudTd>
                <MudTd DataLabel="Outward Date" Class="text-slate-300">
                    @(context.OutwardDate.HasValue ? context.OutwardDate.Value.LocalDateTime.ToString("yyyy-MM-dd HH:mm") : "-")
                </MudTd>
                <MudTd DataLabel="Status">
                    @if (context.Status == "Issued")
                    {
                        <MudChip T="string" Color="Color.Error" Size="Size.Small">Issued</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Success" Size="Size.Small">In Stock</MudChip>
                    }
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    }
</MudContainer>

@code {
    private List<SupplierStockReportDto> _reportLines = new();
    private bool _loading = true;
    private string _searchString = "";
    private string _valuationMethod = "WeightedAverage";

    protected override async Task OnInitializedAsync()
    {
        await LoadReport();
    }

    private async Task OnValuationChanged(string method)
    {
        _valuationMethod = method;
        await LoadReport();
    }

    private async Task LoadReport()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            _reportLines = await Http.GetFromJsonAsync<List<SupplierStockReportDto>>($"api/reports/supplier-stock?valuationMethod={_valuationMethod}") ?? new();
            
            // Load images in background
            foreach (var line in _reportLines)
            {
                if (!string.IsNullOrEmpty(line.ImageUrl) && line.ImageUrl.Contains(".supabase.co/storage/v1/", StringComparison.OrdinalIgnoreCase))
                {
                    _ = Task.Run(async () => {
                        var base64Url = await ImageLoader.LoadImageAsBase64Async(line.ImageUrl);
                        if (!string.IsNullOrEmpty(base64Url))
                        {
                            line.ImageUrl = base64Url;
                            await InvokeAsync(StateHasChanged);
                        }
                    });
                }
            }

            if (_showBarcodeDetails)
            {
                await LoadBarcodeDetails();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading stock report: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private bool _showBarcodeDetails = false;
    private List<BarcodeDetailReportDto> _barcodeDetails = new();
    private bool _loadingBarcodes = false;

    private async Task OnShowBarcodeDetailsChanged(bool val)
    {
        _showBarcodeDetails = val;
        if (_showBarcodeDetails)
        {
            await LoadBarcodeDetails();
        }
    }

    private async Task LoadBarcodeDetails()
    {
        if (!_showBarcodeDetails) return;
        _loadingBarcodes = true;
        StateHasChanged();
        try
        {
            _barcodeDetails.Clear();
            var batchTrackings = _reportLines
                .Select(l => new { l.BatchNo, l.TrackingNo })
                .Distinct()
                .ToList();

            foreach (var bt in batchTrackings)
            {
                var details = await LoadBarcodeDetailsAsync(bt.BatchNo, bt.TrackingNo);
                if (details != null && details.Any())
                {
                    foreach (var d in details)
                    {
                        if (!_barcodeDetails.Any(b => b.BarcodeNo == d.BarcodeNo))
                        {
                            _barcodeDetails.Add(d);
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading barcode details: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loadingBarcodes = false;
            StateHasChanged();
        }
    }

    private async Task<List<BarcodeDetailReportDto>> LoadBarcodeDetailsAsync(string? batchNo, string? trackingNo)
    {
        try
        {
            var response = await Http.GetAsync($"api/reports/barcodes/detail?batchNo={Uri.EscapeDataString(batchNo ?? "")}&trackingNo={Uri.EscapeDataString(trackingNo ?? "")}");
            if (response.IsSuccessStatusCode)
            {
                var details = await response.Content.ReadFromJsonAsync<List<BarcodeDetailReportDto>>();
                if (details != null)
                {
                    foreach (var d in details)
                    {
                        if (!string.IsNullOrEmpty(d.ImageUrl) && d.ImageUrl.Contains(".supabase.co/storage/v1/", StringComparison.OrdinalIgnoreCase))
                        {
                            _ = Task.Run(async () => {
                                var base64 = await ImageLoader.LoadImageAsBase64Async(d.ImageUrl);
                                if (!string.IsNullOrEmpty(base64))
                                {
                                    d.ImageUrl = base64;
                                    await InvokeAsync(StateHasChanged);
                                }
                            });
                        }
                    }
                    return details;
                }
            }
        }
        catch
        {
            // Fallback
        }

        try
        {
            var code = !string.IsNullOrEmpty(trackingNo) ? trackingNo : batchNo;
            if (!string.IsNullOrEmpty(code))
            {
                var response = await Http.GetAsync($"api/reports/barcode-tracking/{Uri.EscapeDataString(code)}");
                if (response.IsSuccessStatusCode)
                {
                    var tracking = await response.Content.ReadFromJsonAsync<BarcodeTrackingReportDto>();
                    if (tracking != null)
                    {
                        var list = new List<BarcodeDetailReportDto>();
                        foreach (var bc in tracking.RegisteredBarcodes)
                        {
                            var isUnique = tracking.RegisteredBarcodes.Count > 1;
                            var issue = tracking.Issues.FirstOrDefault();
                            
                            var item = new BarcodeDetailReportDto
                            {
                                ItemName = tracking.ItemName,
                                BarcodeNo = bc,
                                BatchNo = tracking.BatchNo,
                                TrackingNo = tracking.TrackingNo,
                                Type = isUnique ? "Unique" : "Batch",
                                InwardDate = tracking.InwardDate,
                                OutwardDate = issue?.OutwardDate,
                                Status = issue != null ? "Issued" : "In Stock",
                                ImageUrl = tracking.PhotoUrl
                            };
                            
                            if (!string.IsNullOrEmpty(item.ImageUrl) && item.ImageUrl.Contains(".supabase.co/storage/v1/", StringComparison.OrdinalIgnoreCase))
                            {
                                _ = Task.Run(async () => {
                                    var base64 = await ImageLoader.LoadImageAsBase64Async(item.ImageUrl);
                                    if (!string.IsNullOrEmpty(base64))
                                    {
                                        item.ImageUrl = base64;
                                        await InvokeAsync(StateHasChanged);
                                    }
                                });
                            }
                            
                            list.Add(item);
                        }
                        return list;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading barcode fallback: {ex.Message}", Severity.Warning);
        }

        return new List<BarcodeDetailReportDto>();
    }

    private bool FilterFunc(SupplierStockReportDto element) =>
        string.IsNullOrWhiteSpace(_searchString) ||
        element.ItemName.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
        element.ItemCode.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
        element.SupplierName.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
        element.BatchNo.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
        element.TrackingNo.Contains(_searchString, StringComparison.OrdinalIgnoreCase);

    private string GetAbsoluteImageUrl(string? url)
    {
        if (string.IsNullOrEmpty(url)) return string.Empty;
        
        if (url.Contains(".supabase.co/storage/v1/", StringComparison.OrdinalIgnoreCase))
        {
            var baseAddress = Http.BaseAddress?.ToString().TrimEnd('/') ?? "";
            return $"{baseAddress}/api/storage/image?url={Uri.EscapeDataString(url)}";
        }
        
        var uploadsIndex = url.IndexOf("/uploads/", StringComparison.OrdinalIgnoreCase);
        if (uploadsIndex >= 0)
        {
            var relativePath = url.Substring(uploadsIndex);
            var baseAddress = Http.BaseAddress?.ToString().TrimEnd('/') ?? "";
            return $"{baseAddress}{relativePath}";
        }
        
        if (url.StartsWith("uploads/", StringComparison.OrdinalIgnoreCase))
        {
            var baseAddress = Http.BaseAddress?.ToString().TrimEnd('/') ?? "";
            return $"{baseAddress}/{url}";
        }

        if (url.StartsWith("http://localhost") || url.StartsWith("https://localhost"))
        {
            var uri = new Uri(url);
            var relativePath = uri.PathAndQuery;
            var baseAddress = Http.BaseAddress?.ToString().TrimEnd('/') ?? "";
            return $"{baseAddress}{relativePath}";
        }

        if (url.StartsWith("http://", StringComparison.OrdinalIgnoreCase))
        {
            return "https://" + url.Substring(7);
        }

        return url;
    }

    private async Task PreviewImage(string url)
    {
        var resolvedUrl = await ImageLoader.LoadImageAsBase64Async(url);
        var absoluteUrl = GetAbsoluteImageUrl(resolvedUrl);
        var parameters = new DialogParameters { ["imageUrl"] = absoluteUrl };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium };
        await DialogService.ShowAsync<ImagePreviewDialog>("Item Photo", parameters, options);
    }

    private async Task ExportFile(string format)
    {
        try
        {
            var fileName = $"SupplierStockReport_{_valuationMethod}_{DateTime.Now:yyyyMMddHHmmss}.{(format == "csv" ? "csv" : "xlsx")}";
            var contentType = format == "csv" ? "text/csv" : "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
            
            var response = await Http.GetAsync($"api/reports/export/supplier-stock?format={format}&valuationMethod={_valuationMethod}");
            if (response.IsSuccessStatusCode)
            {
                var fileBytes = await response.Content.ReadAsByteArrayAsync();
                var base64 = Convert.ToBase64String(fileBytes);
                
                await JSRuntime.InvokeVoidAsync("downloadFile", fileName, contentType, base64);
                Snackbar.Add("Report exported successfully!", Severity.Success);
            }
            else
            {
                Snackbar.Add("Export failed.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error exporting: {ex.Message}", Severity.Error);
        }
    }
}
