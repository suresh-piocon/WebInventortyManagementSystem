@page "/reports/barcode-stock-images"
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject InventoryManagement.Client.Services.ImageLoaderService ImageLoader
@inject IJSRuntime JSRuntime

<PageTitle>Barcode Stock Image Report - AG Inventory</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-2">
    <!-- Header -->
    <div class="d-flex flex-column flex-sm-row justify-between align-start align-sm-center mb-6">
        <div>
            <MudText Typo="Typo.h4" Class="font-weight-bold animated-gradient-text" Style="font-family: 'Outfit';">
                Barcode Stock Image Report
            </MudText>
            <MudText Typo="Typo.body2" Class="text-slate-400">
                Visual stock ledger showing barcode item photos, supplier details, and inventory age
            </MudText>
        </div>
    </div>

    <!-- Filter Panel -->
    <MudPaper Class="glass-panel pa-6 mb-6">
        <MudGrid Class="align-center">
            <MudItem xs="12" sm="4" md="3">
                <MudDatePicker Label="Stock Up to Date" 
                               Date="@_upToDate" 
                               DateChanged="OnDateChanged" 
                               Variant="Variant.Outlined" 
                               Class="text-slate-200" 
                               Color="Color.Primary" />
            </MudItem>
            <MudItem xs="12" sm="4" md="6">
                <MudTextField @bind-Value="_searchString" 
                              Placeholder="Search by Barcode, Item Name, Supplier..." 
                              Adornment="Adornment.Start" 
                              AdornmentIcon="@Icons.Material.Filled.Search" 
                              IconSize="Size.Medium" 
                              Variant="Variant.Outlined"
                              Class="text-slate-200" 
                              Immediate="true" />
            </MudItem>
            <MudItem xs="12" sm="4" md="3" Class="d-flex gap-2 justify-end">
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Secondary" 
                           StartIcon="@Icons.Material.Filled.Refresh" 
                           OnClick="RefreshData"
                           Disabled="_loading"
                           Class="w-50 py-3"
                           Style="font-family: 'Outfit'; font-weight: 600; min-height: 56px;">
                    Refresh
                </MudButton>
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Error" 
                           StartIcon="@Icons.Material.Filled.PictureAsPdf" 
                           OnClick="PrintPdf"
                           Disabled="_loading || !FilteredReportItems.Any()"
                           Class="w-50 py-3"
                           Style="font-family: 'Outfit'; font-weight: 600; min-height: 56px;">
                    PDF Print
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <!-- Stats Cards -->
    <MudGrid Class="mb-6">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="glass-panel pa-4 d-flex align-center">
                <div class="pa-3 rounded-lg mr-4" style="background: rgba(92, 92, 255, 0.15);">
                    <MudIcon Icon="@Icons.Material.Filled.Image" Color="Color.Primary" Size="Size.Large" />
                </div>
                <div>
                    <MudText Typo="Typo.caption" Class="text-slate-400">Total Items in Stock</MudText>
                    <MudText Typo="Typo.h5" Class="font-weight-bold text-slate-100">@FilteredReportItems.Count()</MudText>
                </div>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="glass-panel pa-4 d-flex align-center">
                <div class="pa-3 rounded-lg mr-4" style="background: rgba(0, 229, 255, 0.15);">
                    <MudIcon Icon="@Icons.Material.Filled.PhotoLibrary" Color="Color.Secondary" Size="Size.Large" />
                </div>
                <div>
                    <MudText Typo="Typo.caption" Class="text-slate-400">Items with Photo</MudText>
                    <MudText Typo="Typo.h5" Class="font-weight-bold text-slate-100">@FilteredReportItems.Count(i => !string.IsNullOrEmpty(i.ImageUrl))</MudText>
                </div>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="glass-panel pa-4 d-flex align-center">
                <div class="pa-3 rounded-lg mr-4" style="background: rgba(16, 185, 129, 0.15);">
                    <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Color="Color.Success" Size="Size.Large" />
                </div>
                <div>
                    <MudText Typo="Typo.caption" Class="text-slate-400">Average Stock Age</MudText>
                    <MudText Typo="Typo.h5" Class="font-weight-bold text-slate-100">
                        @(FilteredReportItems.Any() ? Math.Round(FilteredReportItems.Average(i => i.StockAgeDays), 1) : 0) Days
                    </MudText>
                </div>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="glass-panel pa-4 d-flex align-center">
                <div class="pa-3 rounded-lg mr-4" style="background: rgba(239, 68, 68, 0.15);">
                    <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Size="Size.Large" />
                </div>
                <div>
                    <MudText Typo="Typo.caption" Class="text-slate-400">Slow Moving (> 30 Days)</MudText>
                    <MudText Typo="Typo.h5" Class="font-weight-bold text-slate-100">@FilteredReportItems.Count(i => i.StockAgeDays > 30)</MudText>
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <!-- Visual Grid -->
    @if (_loading)
    {
        <div class="d-flex flex-column align-center justify-center py-12">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" Class="mb-3" />
            <MudText Class="text-slate-400">Retrieving barcode stock images...</MudText>
        </div>
    }
    else if (!FilteredReportItems.Any())
    {
        <MudPaper Class="glass-panel pa-12 text-center d-flex flex-column align-center justify-center">
            <MudIcon Icon="@Icons.Material.Filled.HideImage" Size="Size.Large" Class="text-slate-500 mb-3" />
            <MudText Typo="Typo.h6" Class="text-slate-300">No stock items found</MudText>
            <MudText Typo="Typo.body2" Class="text-slate-500">Check the selected date or search keywords</MudText>
        </MudPaper>
    }
    else
    {
        <div id="barcode-image-report-container" class="image-report-grid">
            @foreach (var item in FilteredReportItems)
            {
                <div class="image-report-card">
                    <!-- Photo Header -->
                    <div class="image-container">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@GetAbsoluteImageUrl(item.ImageUrl)" 
                                 alt="@item.ItemName" 
                                 class="card-img" 
                                 @onclick="@(() => PreviewImage(item.ImageUrl))" />
                        }
                        else
                        {
                            <div class="card-img-placeholder d-flex flex-column align-center justify-center">
                                <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Large" Class="text-slate-600 mb-2" />
                                <MudText Typo="Typo.caption" Class="text-slate-500">No Photo Captured</MudText>
                            </div>
                        }

                        <!-- Age Badge -->
                        <div class="age-badge @(item.StockAgeDays > 30 ? "age-slow" : "age-normal")">
                            Age: @item.StockAgeDays @(item.StockAgeDays == 1 ? "day" : "days")
                        </div>
                    </div>

                    <!-- Details Body -->
                    <div class="card-details">
                        <!-- Barcode No -->
                        <div class="d-flex justify-between align-center mb-1">
                            <span class="barcode-text">@item.BarcodeNo</span>
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Text" Style="font-size:10px; height:20px; font-weight:bold;">STOCK</MudChip>
                        </div>

                        <!-- Item Name -->
                        <div class="item-name-text mb-2 text-truncate" title="@item.ItemName">
                            @item.ItemName
                        </div>

                        <MudDivider Class="my-2 border-slate-700" />

                        <!-- Details Rows -->
                        <div class="detail-row">
                            <span class="detail-label">Inward Date:</span>
                            <span class="detail-value">@item.InwardDate.LocalDateTime.ToString("dd-MM-yyyy")</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Supplier/Weaver:</span>
                            <span class="detail-value text-truncate" title="@item.SupplierName">@item.SupplierName</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</MudContainer>

<style>
    /* 5-Column Responsive CSS Grid */
    .image-report-grid {
        display: grid;
        grid-template-columns: repeat(1, minmax(0, 1fr));
        gap: 1.25rem;
        margin-top: 1.5rem;
    }
    @@media (min-width: 600px) {
        .image-report-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }
    @@media (min-width: 960px) {
        .image-report-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }
    @@media (min-width: 1280px) {
        .image-report-grid {
            grid-template-columns: repeat(5, minmax(0, 1fr));
        }
    }

    /* Card styling */
    .image-report-card {
        background: rgba(15, 23, 42, 0.45);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 12px;
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        flex-direction: column;
    }
    .image-report-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(92, 92, 255, 0.15);
        border-color: rgba(92, 92, 255, 0.3);
    }

    /* Card Image styling */
    .image-container {
        position: relative;
        width: 100%;
        aspect-ratio: 4/3;
        background: #0f172a;
        overflow: hidden;
        border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .card-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        cursor: pointer;
        transition: transform 0.4s ease;
    }
    .card-img:hover {
        transform: scale(1.08);
    }
    .card-img-placeholder {
        width: 100%;
        height: 100%;
        background: radial-gradient(circle, #1e293b 0%, #0f172a 100%);
    }

    /* Badge overlay */
    .age-badge {
        position: absolute;
        top: 10px;
        right: 10px;
        padding: 4px 8px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        font-family: 'Outfit', sans-serif;
        box-shadow: 0 4px 8px rgba(0,0,0,0.3);
    }
    .age-normal {
        background: rgba(16, 185, 129, 0.9);
        color: white;
    }
    .age-slow {
        background: rgba(239, 68, 68, 0.9);
        color: white;
    }

    /* Details container */
    .card-details {
        padding: 0.85rem;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }
    .barcode-text {
        font-family: 'Outfit', monospace;
        font-weight: 700;
        font-size: 14px;
        color: #E2E8F0;
        letter-spacing: 0.5px;
    }
    .item-name-text {
        font-family: 'Outfit', sans-serif;
        font-weight: 500;
        font-size: 13px;
        color: #94A3B8;
    }

    /* Details alignment */
    .detail-row {
        display: flex;
        justify-content: space-between;
        align-center: center;
        font-size: 11px;
        line-height: 1.6;
        margin-bottom: 2px;
    }
    .detail-label {
        color: #64748B;
    }
    .detail-value {
        color: #CBD5E1;
        font-weight: 600;
        max-width: 70%;
        text-align: right;
    }
</style>

@code {
    private DateTime? _upToDate = DateTime.Today;
    private string _searchString = "";
    private bool _loading = false;
    private List<BarcodeStockImageReportDto> _reportItems = new();

    private IEnumerable<BarcodeStockImageReportDto> FilteredReportItems =>
        _reportItems.Where(i => 
            i.BarcodeNo.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
            i.ItemName.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
            i.SupplierName.Contains(_searchString, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await LoadReportData();
    }

    private async Task OnDateChanged(DateTime? newDate)
    {
        _upToDate = newDate;
        await LoadReportData();
    }

    private async Task RefreshData()
    {
        await LoadReportData();
    }

    private async Task LoadReportData()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            var dateStr = _upToDate?.ToString("yyyy-MM-dd");
            var url = string.IsNullOrEmpty(dateStr) 
                ? "api/reports/barcode-stock-images"
                : $"api/reports/barcode-stock-images?upToDate={Uri.EscapeDataString(dateStr)}";

            _reportItems = await Http.GetFromJsonAsync<List<BarcodeStockImageReportDto>>(url) ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading report data: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private string GetAbsoluteImageUrl(string? url)
    {
        if (string.IsNullOrEmpty(url)) return string.Empty;
        
        if (url.Contains(".supabase.co/storage/v1/", StringComparison.OrdinalIgnoreCase))
        {
            var baseAddress = Http.BaseAddress?.ToString().TrimEnd('/') ?? "";
            return $"{baseAddress}/api/storage/image?url={Uri.EscapeDataString(url)}";
        }
        
        var uploadsIndex = url.IndexOf("/uploads/", StringComparison.OrdinalIgnoreCase);
        if (uploadsIndex >= 0)
        {
            var relativePath = url.Substring(uploadsIndex);
            var baseAddress = Http.BaseAddress?.ToString().TrimEnd('/') ?? "";
            return $"{baseAddress}{relativePath}";
        }
        
        if (url.StartsWith("uploads/", StringComparison.OrdinalIgnoreCase))
        {
            var baseAddress = Http.BaseAddress?.ToString().TrimEnd('/') ?? "";
            return $"{baseAddress}/{url}";
        }
        
        if (url.StartsWith("http://localhost") || url.StartsWith("https://localhost"))
        {
            var uri = new Uri(url);
            var relativePath = uri.PathAndQuery;
            var baseAddress = Http.BaseAddress?.ToString().TrimEnd('/') ?? "";
            return $"{baseAddress}{relativePath}";
        }

        if (url.StartsWith("http://", StringComparison.OrdinalIgnoreCase))
        {
            return "https://" + url.Substring(7);
        }

        return url;
    }

    private async Task PreviewImage(string url)
    {
        var base64Url = await ImageLoader.LoadImageAsBase64Async(url);
        var absoluteUrl = GetAbsoluteImageUrl(base64Url);
        var parameters = new DialogParameters { ["imageUrl"] = absoluteUrl };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium };
        await DialogService.ShowAsync<ImagePreviewDialog>("Photo View", parameters, options);
    }

    private async Task PrintPdf()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("webcamInterop.printElement", "barcode-image-report-container", "Barcode Stock Image Report");
            Snackbar.Add("Print preview opened.", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error printing PDF: {ex.Message}", Severity.Error);
        }
    }
}
