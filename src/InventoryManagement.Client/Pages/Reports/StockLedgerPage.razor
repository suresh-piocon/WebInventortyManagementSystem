@page "/reports/ledger"
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime

<PageTitle>Stock Ledger - AG Inventory</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-2">
    <div class="mb-6">
        <MudText Typo="Typo.h4" Class="font-weight-bold animated-gradient-text" Style="font-family: 'Outfit';">
            Stock Ledger Report
        </MudText>
        <MudText Typo="Typo.body2" Class="text-slate-400">
            Audit item transaction history: Purchases, Sales, Adjustments, and running balances
        </MudText>
    </div>

    <!-- Filter Panel -->
    <MudPaper Class="glass-panel pa-6 mb-4">
        <MudGrid Spacing="3">
            <!-- View Mode Toggle -->
            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="string"
                           Label="View Mode"
                           Value="@_viewMode"
                           ValueChanged="OnViewModeChanged"
                           Variant="Variant.Outlined"
                           Class="text-slate-200">
                    <MudSelectItem Value="@("all")">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.Inventory" Size="Size.Small" />
                            All Items Stock
                        </div>
                    </MudSelectItem>
                    <MudSelectItem Value="@("item")">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.FilterAlt" Size="Size.Small" />
                            Particular Item
                        </div>
                    </MudSelectItem>
                </MudSelect>
            </MudItem>

            <!-- Item Selector (shown only in "item" mode) -->
            @if (_viewMode == "item")
            {
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="Guid"
                               Label="Select Item"
                               Value="@_selectedItemId"
                               ValueChanged="OnItemChanged"
                               Variant="Variant.Outlined"
                               Class="text-slate-200">
                        @foreach (var item in _items)
                        {
                            <MudSelectItem Value="@item.Id">@item.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }
            else
            {
                <MudItem xs="12" sm="6" md="3">
                    <MudTextField T="string"
                                  @bind-Value="_searchString"
                                  Label="Search Item / Reference / Batch"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Variant="Variant.Outlined"
                                  Immediate="true"
                                  Class="text-slate-200" />
                </MudItem>
            }

            <!-- Up To Date Picker -->
            <MudItem xs="12" sm="6" md="3">
                <MudDatePicker Label="Up To Date"
                               Date="@_upToDate"
                               DateChanged="OnUpToDateChanged"
                               Variant="Variant.Outlined"
                               Placeholder="All dates"
                               Clearable="true"
                               Class="text-slate-200" />
            </MudItem>

            <!-- Item Info (item mode) -->
            @if (_viewMode == "item" && _selectedItem != null)
            {
                <MudItem xs="12" sm="6" md="3" Class="d-flex align-center">
                    <div class="d-flex flex-column text-slate-300">
                        <span>Category: <b>@_selectedItem.Category?.Name</b></span>
                        <span>Tracking: <b>@_selectedItem.BarcodeType</b></span>
                    </div>
                </MudItem>
            }
            else if (_viewMode == "all")
            {
                <MudItem xs="12" sm="6" md="3" Class="d-flex align-center gap-2">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="LoadLedger"
                               Disabled="@_loading"
                               Size="Size.Small">
                        Refresh
                    </MudButton>
                    @if (_upToDate.HasValue)
                    {
                        <MudChip T="string" Color="Color.Warning" Size="Size.Small" Icon="@Icons.Material.Filled.CalendarToday">
                            Up to @_upToDate.Value.ToString("dd MMM yyyy")
                        </MudChip>
                    }
                </MudItem>
            }
        </MudGrid>
    </MudPaper>

    <!-- Summary Cards -->
    @if (_ledger.Any() || _allLedger.Any())
    {
        <MudGrid Spacing="3" Class="mb-4">
            <MudItem xs="12" sm="4">
                <MudPaper Class="glass-panel pa-4 d-flex align-center gap-3" Style="border-left: 3px solid #22c55e;">
                    <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Style="color: #22c55e; font-size: 2rem;" />
                    <div>
                        <MudText Typo="Typo.caption" Class="text-slate-400">Total Inward</MudText>
                        <MudText Typo="Typo.h6" Class="text-green-400 font-weight-bold">
                            +@(GetTotalInward().ToString("N2"))
                        </MudText>
                    </div>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudPaper Class="glass-panel pa-4 d-flex align-center gap-3" Style="border-left: 3px solid #ef4444;">
                    <MudIcon Icon="@Icons.Material.Filled.TrendingDown" Style="color: #ef4444; font-size: 2rem;" />
                    <div>
                        <MudText Typo="Typo.caption" Class="text-slate-400">Total Outward</MudText>
                        <MudText Typo="Typo.h6" Class="text-red-400 font-weight-bold">
                            -@(GetTotalOutward().ToString("N2"))
                        </MudText>
                    </div>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudPaper Class="glass-panel pa-4 d-flex align-center gap-3" Style="border-left: 3px solid #6366f1;">
                    <MudIcon Icon="@Icons.Material.Filled.Inventory2" Style="color: #818cf8; font-size: 2rem;" />
                    <div>
                        <MudText Typo="Typo.caption" Class="text-slate-400">Closing Balance</MudText>
                        <MudText Typo="Typo.h6" Class="text-slate-100 font-weight-bold">
                            @(GetClosingBalance().ToString("N2"))
                        </MudText>
                    </div>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }

    <!-- ============================================================ -->
    <!-- ALL ITEMS VIEW -->
    <!-- ============================================================ -->
    @if (_viewMode == "all")
    {
        <MudTable Items="@FilteredAllLedger"
                  Hover="true"
                  Loading="@_loading"
                  Class="glass-panel text-slate-200"
                  Dense="true"
                  Striped="true">
            <ToolBarContent>
                <MudText Typo="Typo.h6" Style="font-family: 'Outfit'; color: #E2E8F0;">
                    <MudIcon Icon="@Icons.Material.Filled.Inventory" Class="mr-2" />
                    All Items Stock Ledger
                    @if (_upToDate.HasValue)
                    {
                        <span class="text-slate-400" style="font-size:13px; font-weight:400;"> — Up to @_upToDate.Value.ToString("dd MMM yyyy")</span>
                    }
                </MudText>
                <MudSpacer />
                <MudChip T="string" Color="Color.Default" Size="Size.Small" Class="mr-2">
                    @FilteredAllLedger.Count() Rows
                </MudChip>
                <MudMenu StartIcon="@Icons.Material.Filled.Download" Label="Export" Color="Color.Secondary" Variant="Variant.Filled" EndIcon="@Icons.Material.Filled.KeyboardArrowDown">
                    <MudMenuItem OnClick="@(() => ExportAllLedger("csv"))" Icon="@Icons.Material.Filled.TextSnippet" IconColor="Color.Info">CSV</MudMenuItem>
                    <MudMenuItem OnClick="@(() => ExportAllLedger("excel"))" Icon="@Icons.Custom.FileFormats.FileExcel" IconColor="Color.Success">Excel</MudMenuItem>
                </MudMenu>
            </ToolBarContent>
            <HeaderContent>
                <MudTh Style="color: #94A3B8;">Date &amp; Time</MudTh>
                <MudTh Style="color: #94A3B8;">Item</MudTh>
                <MudTh Style="color: #94A3B8;">Type</MudTh>
                <MudTh Style="color: #94A3B8;">Reference No</MudTh>
                <MudTh Style="color: #94A3B8;">Batch / Tracking</MudTh>
                <MudTh Style="color: #94A3B8; text-align: right;">Inward Qty</MudTh>
                <MudTh Style="color: #94A3B8; text-align: right;">Inward Wt (Kg)</MudTh>
                <MudTh Style="color: #94A3B8; text-align: right;">Outward Qty</MudTh>
                <MudTh Style="color: #94A3B8; text-align: right;">Outward Wt (Kg)</MudTh>
                <MudTh Style="color: #94A3B8; text-align: right;">Balance Qty</MudTh>
                <MudTh Style="color: #94A3B8; text-align: right;">Balance Wt (Kg)</MudTh>
                <MudTh Style="color: #94A3B8; text-align: right;">Unit Price</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Date & Time" Class="text-slate-300" Style="font-size:12px;">
                    @context.TransactionDate.LocalDateTime.ToString("dd-MM-yyyy HH:mm")
                </MudTd>
                <MudTd DataLabel="Item">
                    <div class="text-slate-100 font-weight-bold" style="font-size:13px;">@context.ItemName</div>
                    <div class="text-slate-500 font-mono" style="font-size:10px;">@context.ItemCode</div>
                </MudTd>
                <MudTd DataLabel="Type">
                    @if (context.TransactionType == "Purchase")
                    {
                        <MudChip T="string" Color="Color.Success" Size="Size.Small">Inward</MudChip>
                    }
                    else if (context.TransactionType == "Sales")
                    {
                        <MudChip T="string" Color="Color.Error" Size="Size.Small">Outward</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Warning" Size="Size.Small">@context.TransactionType</MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="Reference No" Class="text-slate-200 font-weight-bold">@context.ReferenceNo</MudTd>
                <MudTd DataLabel="Batch / Tracking">
                    <div Class="text-slate-200" style="font-size:12px;">@context.BatchNo</div>
                    <div Class="text-slate-500 font-mono" style="font-size:10px;">@context.TrackingNo</div>
                </MudTd>
                <MudTd DataLabel="Inward Qty" Style="text-align: right;" Class="text-green-400 font-weight-bold">
                    @(context.InwardQty > 0 ? $"+{context.InwardQty:N2}" : "-")
                </MudTd>
                <MudTd DataLabel="Inward Wt (Kg)" Style="text-align: right;" Class="text-green-400">
                    @(context.InwardWeight > 0 ? $"+{context.InwardWeight:F3}" : "-")
                </MudTd>
                <MudTd DataLabel="Outward Qty" Style="text-align: right;" Class="text-red-400 font-weight-bold">
                    @(context.OutwardQty > 0 ? $"-{context.OutwardQty:N2}" : "-")
                </MudTd>
                <MudTd DataLabel="Outward Wt (Kg)" Style="text-align: right;" Class="text-red-400">
                    @(context.OutwardWeight > 0 ? $"-{context.OutwardWeight:F3}" : "-")
                </MudTd>
                <MudTd DataLabel="Balance Qty" Style="text-align: right;" Class="text-slate-100 font-weight-bold">
                    @context.BalanceQty.ToString("N2")
                </MudTd>
                <MudTd DataLabel="Balance Wt (Kg)" Style="text-align: right;" Class="text-slate-200 font-weight-bold">
                    @context.BalanceWeight.ToString("F3")
                </MudTd>
                <MudTd DataLabel="Unit Price" Style="text-align: right;" Class="text-slate-300">
                    ₹@context.UnitPrice.ToString("N2")
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
            <NoRecordsContent>
                <MudText Class="text-slate-400 pa-6">No transactions found. @(_upToDate.HasValue ? $"No data up to {_upToDate.Value:dd MMM yyyy}." : "Please check back later.")</MudText>
            </NoRecordsContent>
        </MudTable>

        <!-- Per-Item Balance Summary for All Items view -->
        @if (_allLedger.Any())
        {
            <MudPaper Class="glass-panel pa-6 mt-4">
                <MudText Typo="Typo.h6" Class="text-slate-200 mb-4" Style="font-family: 'Outfit';">
                    <MudIcon Icon="@Icons.Material.Filled.BarChart" Class="mr-2" />
                    Closing Balance Summary @(_upToDate.HasValue ? $"(As of {_upToDate.Value:dd MMM yyyy})" : "(Current)")
                </MudText>
                <MudTable Items="@GetItemSummary()" Hover="true" Dense="true" Class="text-slate-200" Style="background: transparent;">
                    <HeaderContent>
                        <MudTh Style="color: #94A3B8;">Item Code</MudTh>
                        <MudTh Style="color: #94A3B8;">Item Name</MudTh>
                        <MudTh Style="color: #94A3B8; text-align:right;">Total Inward</MudTh>
                        <MudTh Style="color: #94A3B8; text-align:right;">Total Outward</MudTh>
                        <MudTh Style="color: #94A3B8; text-align:right;">Closing Balance</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd Class="text-slate-400 font-mono" Style="font-size:11px;">@context.ItemCode</MudTd>
                        <MudTd Class="text-slate-100 font-weight-bold">@context.ItemName</MudTd>
                        <MudTd Style="text-align:right;" Class="text-green-400">+@context.TotalInward.ToString("N2")</MudTd>
                        <MudTd Style="text-align:right;" Class="text-red-400">-@context.TotalOutward.ToString("N2")</MudTd>
                        <MudTd Style="text-align:right;" Class="@(context.ClosingBalance > 0 ? "text-yellow-400 font-weight-bold" : "text-slate-500")">
                            @context.ClosingBalance.ToString("N2")
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        }
    }

    <!-- ============================================================ -->
    <!-- PARTICULAR ITEM VIEW -->
    <!-- ============================================================ -->
    @if (_viewMode == "item")
    {
        <MudTable Items="@_ledger"
                  Hover="true"
                  Loading="@_loading"
                  Class="glass-panel text-slate-200"
                  Dense="true">
            <ToolBarContent>
                <MudText Typo="Typo.h6" Style="font-family: 'Outfit'; color: #E2E8F0;">
                    <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Class="mr-2" />
                    @(_selectedItem?.Name ?? "Select an item") — Ledger
                    @if (_upToDate.HasValue)
                    {
                        <span class="text-slate-400" style="font-size:13px; font-weight:400;"> up to @_upToDate.Value.ToString("dd MMM yyyy")</span>
                    }
                </MudText>
                <MudSpacer />
                <MudChip T="string" Color="Color.Default" Size="Size.Small" Class="mr-2">
                    @_ledger.Count Rows
                </MudChip>
                <MudMenu StartIcon="@Icons.Material.Filled.Download" Label="Export" Color="Color.Secondary" Variant="Variant.Filled" EndIcon="@Icons.Material.Filled.KeyboardArrowDown">
                    <MudMenuItem OnClick="@(() => ExportItemLedger("csv"))" Icon="@Icons.Material.Filled.TextSnippet" IconColor="Color.Info">CSV</MudMenuItem>
                    <MudMenuItem OnClick="@(() => ExportItemLedger("excel"))" Icon="@Icons.Custom.FileFormats.FileExcel" IconColor="Color.Success">Excel</MudMenuItem>
                </MudMenu>
            </ToolBarContent>
            <HeaderContent>
                <MudTh Style="color: #94A3B8;">Date &amp; Time</MudTh>
                <MudTh Style="color: #94A3B8;">Type</MudTh>
                <MudTh Style="color: #94A3B8;">Reference No</MudTh>
                <MudTh Style="color: #94A3B8;">Batch No</MudTh>
                <MudTh Style="color: #94A3B8;">Tracking No</MudTh>
                <MudTh Style="color: #94A3B8; text-align: right;">Inward Qty</MudTh>
                <MudTh Style="color: #94A3B8; text-align: right;">Inward Wt (Kg)</MudTh>
                <MudTh Style="color: #94A3B8; text-align: right;">Outward Qty</MudTh>
                <MudTh Style="color: #94A3B8; text-align: right;">Outward Wt (Kg)</MudTh>
                <MudTh Style="color: #94A3B8; text-align: right;">Running Balance Qty</MudTh>
                <MudTh Style="color: #94A3B8; text-align: right;">Running Balance Wt (Kg)</MudTh>
                <MudTh Style="color: #94A3B8; text-align: right;">Unit Price</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Date & Time" Class="text-slate-300">@context.TransactionDate.LocalDateTime.ToString("dd-MM-yyyy HH:mm")</MudTd>
                <MudTd DataLabel="Type">
                    @if (context.TransactionType == "Purchase")
                    {
                        <MudChip T="string" Color="Color.Success" Size="Size.Small">Inward</MudChip>
                    }
                    else if (context.TransactionType == "Sales")
                    {
                        <MudChip T="string" Color="Color.Error" Size="Size.Small">Outward</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Warning" Size="Size.Small">@context.TransactionType</MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="Reference No" Class="text-slate-200 font-weight-bold">@context.ReferenceNo</MudTd>
                <MudTd DataLabel="Batch No" Class="text-slate-200">@context.BatchNo</MudTd>
                <MudTd DataLabel="Tracking No" Class="text-slate-400 font-mono" Style="font-size: 11px;">@context.TrackingNo</MudTd>
                <MudTd DataLabel="Inward Qty" Style="text-align: right;" Class="text-green-400 font-weight-bold">
                    @(context.InwardQty > 0 ? $"+{context.InwardQty.ToString("N2")}" : "-")
                </MudTd>
                <MudTd DataLabel="Inward Wt (Kg)" Style="text-align: right;" Class="text-green-400">
                    @(context.InwardWeight > 0 ? $"+{context.InwardWeight.ToString("F3")}" : "-")
                </MudTd>
                <MudTd DataLabel="Outward Qty" Style="text-align: right;" Class="text-red-400 font-weight-bold">
                    @(context.OutwardQty > 0 ? $"-{context.OutwardQty.ToString("N2")}" : "-")
                </MudTd>
                <MudTd DataLabel="Outward Wt (Kg)" Style="text-align: right;" Class="text-red-400">
                    @(context.OutwardWeight > 0 ? $"-{context.OutwardWeight.ToString("F3")}" : "-")
                </MudTd>
                <MudTd DataLabel="Running Balance Qty" Style="text-align: right;" Class="text-slate-100 font-weight-bold">
                    @context.BalanceQty.ToString("N2")
                </MudTd>
                <MudTd DataLabel="Running Balance Wt (Kg)" Style="text-align: right;" Class="text-slate-200 font-weight-bold">
                    @context.BalanceWeight.ToString("F3")
                </MudTd>
                <MudTd DataLabel="Unit Price" Style="text-align: right;" Class="text-slate-300">₹@context.UnitPrice.ToString("N2")</MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
            <NoRecordsContent>
                <MudText Class="text-slate-400 pa-6">
                    @(_selectedItemId == Guid.Empty ? "Select an item to view its ledger." : "No transactions found for the selected filters.")
                </MudText>
            </NoRecordsContent>
        </MudTable>
    }

    <!-- ============================================================ -->
    <!-- BARCODE DETAIL PANEL (Toggle) -->
    <!-- ============================================================ -->
    <MudPaper Class="glass-panel pa-6 mt-4">
        <div class="d-flex align-center justify-between mb-4">
            <MudText Typo="Typo.h6" Style="font-family: 'Outfit'; color: #E2E8F0;">
                <MudIcon Icon="@Icons.Material.Filled.QrCode" Class="mr-2 text-cyan" />
                Detailed Barcode Info (In/Out with Photos)
            </MudText>
            <MudSwitch T="bool"
                       Value="@_showBarcodeDetails"
                       ValueChanged="OnShowBarcodeDetailsChanged"
                       Color="Color.Info"
                       Label="@(_showBarcodeDetails ? "Visible" : "Show")"
                       Class="text-slate-200" />
        </div>

        @if (_showBarcodeDetails)
        {
            <!-- Barcode Date Filters -->
            <MudGrid Spacing="2" Class="mb-4">
                <MudItem xs="12" sm="4" md="3">
                    <MudDatePicker Label="From Date"
                                   Date="@_barcodeFromDate"
                                   DateChanged="OnBarcodeFromDateChanged"
                                   Variant="Variant.Outlined"
                                   Placeholder="All dates"
                                   Clearable="true"
                                   Class="text-slate-200" />
                </MudItem>
                <MudItem xs="12" sm="4" md="3">
                    <MudDatePicker Label="To Date"
                                   Date="@_barcodeToDate"
                                   DateChanged="OnBarcodeToDateChanged"
                                   Variant="Variant.Outlined"
                                   Placeholder="All dates"
                                   Clearable="true"
                                   Class="text-slate-200" />
                </MudItem>
                <MudItem xs="12" sm="4" md="3" Class="d-flex align-center gap-2">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.FilterAlt"
                               OnClick="LoadBarcodeDetails"
                               Disabled="@_loadingBarcodes"
                               Size="Size.Medium">
                        Apply Filter
                    </MudButton>
                    @if (_barcodeFromDate.HasValue || _barcodeToDate.HasValue)
                    {
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   OnClick="ClearBarcodeDateFilter"
                                   Size="Size.Medium">
                            Clear
                        </MudButton>
                    }
                </MudItem>
                <MudItem xs="12" sm="12" md="3" Class="d-flex align-center justify-end">
                    <MudMenu StartIcon="@Icons.Material.Filled.Download"
                             Label="Export Barcodes"
                             Color="Color.Info"
                             Variant="Variant.Filled"
                             EndIcon="@Icons.Material.Filled.KeyboardArrowDown">
                        <MudMenuItem OnClick="ExportBarcodesExcel" Icon="@Icons.Custom.FileFormats.FileExcel" IconColor="Color.Success">Excel (.xls)</MudMenuItem>
                        <MudMenuItem OnClick="ExportBarcodesCsv" Icon="@Icons.Material.Filled.TextSnippet" IconColor="Color.Info">CSV (.csv)</MudMenuItem>
                        <MudMenuItem OnClick="ExportBarcodesPdf" Icon="@Icons.Material.Filled.PictureAsPdf" IconColor="Color.Error">PDF Print</MudMenuItem>
                    </MudMenu>
                </MudItem>
            </MudGrid>

            <MudTable id="barcode-table-container"
                      Items="@_barcodeDetails"
                      Hover="true"
                      Loading="@_loadingBarcodes"
                      Class="text-slate-200"
                      Dense="true"
                      Style="background: transparent;">
                <HeaderContent>
                    <MudTh Style="color: #94A3B8; text-align: center; width: 60px;">Photo</MudTh>
                    <MudTh Style="color: #94A3B8;">Item Name</MudTh>
                    <MudTh Style="color: #94A3B8;">Barcode No</MudTh>
                    <MudTh Style="color: #94A3B8;">Batch No</MudTh>
                    <MudTh Style="color: #94A3B8;">Tracking No</MudTh>
                    <MudTh Style="color: #94A3B8;">Type</MudTh>
                    <MudTh Style="color: #94A3B8;">Inward Date</MudTh>
                    <MudTh Style="color: #94A3B8;">Outward Date</MudTh>
                    <MudTh Style="color: #94A3B8;">Status</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Style="text-align: center;">
                        @if (!string.IsNullOrEmpty(context.ImageUrl))
                        {
                            <img src="@GetAbsoluteImageUrl(context.ImageUrl)"
                                 style="width: 40px; height: 40px; border-radius: 6px; object-fit: cover; border: 1px solid #5C5CFF; cursor: pointer;"
                                 @onclick="@(() => PreviewImage(context.ImageUrl))" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.ImageNotSupported" Color="Color.Dark" />
                        }
                    </MudTd>
                    <MudTd DataLabel="Item Name" Class="text-slate-100 font-weight-bold">@context.ItemName</MudTd>
                    <MudTd DataLabel="Barcode No" Class="text-slate-200 font-mono">@context.BarcodeNo</MudTd>
                    <MudTd DataLabel="Batch No" Class="text-slate-300">@context.BatchNo</MudTd>
                    <MudTd DataLabel="Tracking No" Class="text-slate-400 font-mono" Style="font-size: 11px;">@context.TrackingNo</MudTd>
                    <MudTd DataLabel="Type">
                        <MudChip T="string" Color="Color.Default" Size="Size.Small">@context.Type</MudChip>
                    </MudTd>
                    <MudTd DataLabel="Inward Date" Class="text-slate-300">@context.InwardDate.LocalDateTime.ToString("dd-MM-yyyy HH:mm")</MudTd>
                    <MudTd DataLabel="Outward Date" Class="text-slate-300">
                        @(context.OutwardDate.HasValue ? context.OutwardDate.Value.LocalDateTime.ToString("dd-MM-yyyy HH:mm") : "-")
                    </MudTd>
                    <MudTd DataLabel="Status">
                        @if (context.Status == "Issued")
                        {
                            <MudChip T="string" Color="Color.Error" Size="Size.Small">Issued</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Color="Color.Success" Size="Size.Small">In Stock</MudChip>
                        }
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
                <NoRecordsContent>
                    <MudText Class="text-slate-400 pa-4">No barcode records found for the selected filters.</MudText>
                </NoRecordsContent>
            </MudTable>
        }
    </MudPaper>

</MudContainer>

@code {
    // ── Items master ──────────────────────────────────────────────
    private List<Item> _items = new();
    private string _viewMode = "all";          // "all" | "item"
    private Guid _selectedItemId = Guid.Empty;
    private Item? _selectedItem;
    private string _searchString = string.Empty;

    // ── Date filter ───────────────────────────────────────────────
    private DateTime? _upToDate = null;

    // ── All-items ledger ──────────────────────────────────────────
    private List<AllItemsLedgerDto> _allLedger = new();
    private IEnumerable<AllItemsLedgerDto> FilteredAllLedger =>
        string.IsNullOrWhiteSpace(_searchString)
            ? _allLedger
            : _allLedger.Where(l =>
                l.ItemName.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
                l.ItemCode.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
                l.ReferenceNo.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
                l.BatchNo.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
                l.TrackingNo.Contains(_searchString, StringComparison.OrdinalIgnoreCase));

    // ── Per-item ledger ───────────────────────────────────────────
    private List<StockLedger> _ledger = new();
    private bool _loading = false;

    // ── Barcode details panel ─────────────────────────────────────
    private bool _showBarcodeDetails = false;
    private List<BarcodeDetailReportDto> _barcodeDetails = new();
    private bool _loadingBarcodes = false;
    private DateTime? _barcodeFromDate = null;
    private DateTime? _barcodeToDate = null;

    // ─────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        await LoadItems();
        await LoadLedger();
    }

    private async Task LoadItems()
    {
        try
        {
            _items = await Http.GetFromJsonAsync<List<Item>>("api/masters/items") ?? new();
            if (_items.Any())
            {
                _selectedItemId = _items.First().Id;
                _selectedItem = _items.First();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading items: {ex.Message}", Severity.Error);
        }
    }

    // ── Load ledger based on current mode ────────────────────────
    private async Task LoadLedger()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            if (_viewMode == "all")
            {
                var url = BuildUrl("api/reports/ledger/all", _upToDate);
                _allLedger = await Http.GetFromJsonAsync<List<AllItemsLedgerDto>>(url) ?? new();
                _ledger = new();
            }
            else
            {
                if (_selectedItemId == Guid.Empty) { _loading = false; return; }
                var url = BuildUrl($"api/reports/ledger/{_selectedItemId}", _upToDate);
                _ledger = await Http.GetFromJsonAsync<List<StockLedger>>(url) ?? new();
                _allLedger = new();
            }

            if (_showBarcodeDetails)
                await LoadBarcodeDetails();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading ledger: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private static string BuildUrl(string baseUrl, DateTime? upToDate)
    {
        if (upToDate.HasValue)
        {
            var iso = upToDate.Value.ToString("yyyy-MM-dd");
            return $"{baseUrl}?upToDate={Uri.EscapeDataString(iso)}";
        }
        return baseUrl;
    }

    // ── Event handlers ────────────────────────────────────────────
    private async Task OnViewModeChanged(string mode)
    {
        _viewMode = mode;
        _searchString = string.Empty;
        await LoadLedger();
    }

    private async Task OnItemChanged(Guid itemId)
    {
        _selectedItemId = itemId;
        _selectedItem = _items.FirstOrDefault(i => i.Id == itemId);
        await LoadLedger();
    }

    private async Task OnUpToDateChanged(DateTime? date)
    {
        _upToDate = date;
        await LoadLedger();
    }

    // ── Summary helpers ───────────────────────────────────────────
    private decimal GetTotalInward() =>
        _viewMode == "all"
            ? _allLedger.Sum(l => l.InwardQty)
            : _ledger.Sum(l => l.InwardQty);

    private decimal GetTotalOutward() =>
        _viewMode == "all"
            ? _allLedger.Sum(l => l.OutwardQty)
            : _ledger.Sum(l => l.OutwardQty);

    private decimal GetClosingBalance() =>
        GetTotalInward() - GetTotalOutward();

    private record ItemSummaryRow(string ItemCode, string ItemName, decimal TotalInward, decimal TotalOutward, decimal ClosingBalance);

    private List<ItemSummaryRow> GetItemSummary()
    {
        return _allLedger
            .GroupBy(l => new { l.ItemId, l.ItemCode, l.ItemName })
            .Select(g => new ItemSummaryRow(
                g.Key.ItemCode,
                g.Key.ItemName,
                g.Sum(l => l.InwardQty),
                g.Sum(l => l.OutwardQty),
                g.Sum(l => l.InwardQty) - g.Sum(l => l.OutwardQty)
            ))
            .OrderBy(r => r.ItemName)
            .ToList();
    }

    // ── Barcode detail panel ──────────────────────────────────────
    private async Task OnShowBarcodeDetailsChanged(bool val)
    {
        _showBarcodeDetails = val;
        if (_showBarcodeDetails)
            await LoadBarcodeDetails();
    }

    private void OnBarcodeFromDateChanged(DateTime? date)
    {
        _barcodeFromDate = date;
    }

    private void OnBarcodeToDateChanged(DateTime? date)
    {
        _barcodeToDate = date;
    }

    private async Task ClearBarcodeDateFilter()
    {
        _barcodeFromDate = null;
        _barcodeToDate = null;
        await LoadBarcodeDetails();
    }

    private async Task LoadBarcodeDetails()
    {
        if (!_showBarcodeDetails) return;
        _loadingBarcodes = true;
        StateHasChanged();
        try
        {
            _barcodeDetails.Clear();

            // Gather unique batch/tracking combos from current ledger view
            IEnumerable<(string BatchNo, string TrackingNo)> combos;
            if (_viewMode == "all")
            {
                combos = _allLedger
                    .Select(l => (l.BatchNo, l.TrackingNo))
                    .Distinct();
            }
            else
            {
                combos = _ledger
                    .Select(l => (l.BatchNo, l.TrackingNo))
                    .Distinct();
            }

            foreach (var (batchNo, trackingNo) in combos)
            {
                var url = BuildBarcodeDetailUrl(batchNo, trackingNo, _barcodeFromDate, _barcodeToDate);
                try
                {
                    var response = await Http.GetAsync(url);
                    if (response.IsSuccessStatusCode)
                    {
                        var details = await response.Content.ReadFromJsonAsync<List<BarcodeDetailReportDto>>();
                        if (details != null)
                        {
                            foreach (var d in details)
                            {
                                if (!_barcodeDetails.Any(b => b.BarcodeNo == d.BarcodeNo))
                                    _barcodeDetails.Add(d);
                            }
                        }
                    }
                }
                catch { /* skip failed detail fetch */ }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading barcode details: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loadingBarcodes = false;
            StateHasChanged();
        }
    }

    private static string BuildBarcodeDetailUrl(string? batchNo, string? trackingNo, DateTime? fromDate, DateTime? toDate)
    {
        var sb = new System.Text.StringBuilder("api/reports/barcodes/detail?");
        sb.Append($"batchNo={Uri.EscapeDataString(batchNo ?? "")}");
        sb.Append($"&trackingNo={Uri.EscapeDataString(trackingNo ?? "")}");
        if (fromDate.HasValue)
            sb.Append($"&fromDate={Uri.EscapeDataString(fromDate.Value.ToString("yyyy-MM-dd"))}");
        if (toDate.HasValue)
            sb.Append($"&toDate={Uri.EscapeDataString(toDate.Value.ToString("yyyy-MM-dd"))}");
        return sb.ToString();
    }

    // ── Image helpers ─────────────────────────────────────────────
    private string GetAbsoluteImageUrl(string? url)
    {
        if (string.IsNullOrEmpty(url)) return string.Empty;
        if (url.StartsWith("data:image/", StringComparison.OrdinalIgnoreCase)) return url;

        if (url.Contains(".supabase.co/storage/v1/", StringComparison.OrdinalIgnoreCase))
        {
            var baseAddress = Http.BaseAddress?.ToString().TrimEnd('/') ?? "";
            return $"{baseAddress}/api/storage/image?url={Uri.EscapeDataString(url)}";
        }

        var uploadsIndex = url.IndexOf("/uploads/", StringComparison.OrdinalIgnoreCase);
        if (uploadsIndex >= 0)
        {
            var relativePath = url.Substring(uploadsIndex);
            var baseAddress = Http.BaseAddress?.ToString().TrimEnd('/') ?? "";
            return $"{baseAddress}{relativePath}";
        }

        if (url.StartsWith("uploads/", StringComparison.OrdinalIgnoreCase))
        {
            var baseAddress = Http.BaseAddress?.ToString().TrimEnd('/') ?? "";
            return $"{baseAddress}/{url}";
        }

        if (url.StartsWith("http://localhost") || url.StartsWith("https://localhost"))
        {
            var uri = new Uri(url);
            var relativePath = uri.PathAndQuery;
            var baseAddress = Http.BaseAddress?.ToString().TrimEnd('/') ?? "";
            return $"{baseAddress}{relativePath}";
        }

        if (url.StartsWith("http://", StringComparison.OrdinalIgnoreCase))
            return "https://" + url.Substring(7);

        return url;
    }

    private async Task PreviewImage(string url)
    {
        var absoluteUrl = GetAbsoluteImageUrl(url);
        var parameters = new DialogParameters { ["imageUrl"] = absoluteUrl };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium };
        await DialogService.ShowAsync<ImagePreviewDialog>("Item Photo", parameters, options);
    }

    // ── Export: All Ledger ────────────────────────────────────────
    private async Task ExportAllLedger(string format)
    {
        try
        {
            var data = FilteredAllLedger.ToList();
            if (!data.Any()) { Snackbar.Add("No data to export.", Severity.Warning); return; }

            if (format == "csv")
            {
                var sb = new System.Text.StringBuilder();
                sb.AppendLine("Date,Item Code,Item Name,Type,Reference No,Batch No,Tracking No,Inward Qty,Outward Qty,Balance Qty,Unit Price");
                foreach (var row in data)
                {
                    sb.Append(row.TransactionDate.LocalDateTime.ToString("yyyy-MM-dd HH:mm")).Append(",")
                      .Append(row.ItemCode).Append(",")
                      .Append(EscapedCsv(row.ItemName)).Append(",")
                      .Append(row.TransactionType).Append(",")
                      .Append(row.ReferenceNo).Append(",")
                      .Append(row.BatchNo).Append(",")
                      .Append(row.TrackingNo).Append(",")
                      .Append(row.InwardQty).Append(",")
                      .Append(row.OutwardQty).Append(",")
                      .Append(row.BalanceQty).Append(",")
                      .Append(row.UnitPrice).AppendLine();
                }
                var bytes = System.Text.Encoding.UTF8.GetBytes(sb.ToString());
                await JSRuntime.InvokeVoidAsync("webcamInterop.downloadFile", $"StockLedger_All_{DateTime.Now:yyyyMMdd}.csv", "text/csv", Convert.ToBase64String(bytes));
                Snackbar.Add("CSV exported!", Severity.Success);
            }
            else
            {
                var sb = new System.Text.StringBuilder();
                sb.AppendLine("<html><head><meta charset=\"utf-8\"><style>table{border-collapse:collapse;}th,td{border:1px solid #000;padding:5px;}</style></head><body><table><thead><tr><th>Date</th><th>Item Code</th><th>Item Name</th><th>Type</th><th>Reference No</th><th>Batch No</th><th>Tracking No</th><th>Inward</th><th>Outward</th><th>Balance</th><th>Unit Price</th></tr></thead><tbody>");
                foreach (var row in data)
                {
                    sb.Append("<tr>")
                      .Append($"<td>{row.TransactionDate.LocalDateTime:yyyy-MM-dd HH:mm}</td>")
                      .Append($"<td>{row.ItemCode}</td>")
                      .Append($"<td>{System.Net.WebUtility.HtmlEncode(row.ItemName)}</td>")
                      .Append($"<td>{row.TransactionType}</td>")
                      .Append($"<td>{row.ReferenceNo}</td>")
                      .Append($"<td>{row.BatchNo}</td>")
                      .Append($"<td>{row.TrackingNo}</td>")
                      .Append($"<td>{row.InwardQty:N2}</td>")
                      .Append($"<td>{row.OutwardQty:N2}</td>")
                      .Append($"<td>{row.BalanceQty:N2}</td>")
                      .Append($"<td>{row.UnitPrice:N2}</td>")
                      .Append("</tr>");
                }
                sb.Append("</tbody></table></body></html>");
                var bytes = System.Text.Encoding.UTF8.GetBytes(sb.ToString());
                await JSRuntime.InvokeVoidAsync("webcamInterop.downloadFile", $"StockLedger_All_{DateTime.Now:yyyyMMdd}.xls", "application/vnd.ms-excel", Convert.ToBase64String(bytes));
                Snackbar.Add("Excel exported!", Severity.Success);
            }
        }
        catch (Exception ex) { Snackbar.Add($"Export error: {ex.Message}", Severity.Error); }
    }

    // ── Export: Per-item Ledger ───────────────────────────────────
    private async Task ExportItemLedger(string format)
    {
        try
        {
            if (!_ledger.Any()) { Snackbar.Add("No data to export.", Severity.Warning); return; }
            if (format == "csv")
            {
                var sb = new System.Text.StringBuilder();
                sb.AppendLine("Date,Type,Reference No,Batch No,Tracking No,Inward Qty,Outward Qty,Balance Qty,Unit Price");
                foreach (var row in _ledger)
