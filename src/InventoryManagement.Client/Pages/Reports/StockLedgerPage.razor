@page "/reports/ledger"
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime

<PageTitle>Stock Ledger - AG Inventory</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-2">
    <div class="mb-6">
        <MudText Typo="Typo.h4" Class="font-weight-bold animated-gradient-text" Style="font-family: 'Outfit';">
            Stock Ledger Report
        </MudText>
        <MudText Typo="Typo.body2" Class="text-slate-400">
            Audit item transaction history: Purchases, Sales, Adjustments, and running balances
        </MudText>
    </div>

    <!-- Selection Panel -->
    <MudPaper Class="glass-panel pa-6 mb-6">
        <MudGrid>
            <MudItem xs="12" sm="6" md="4">
                <MudSelect T="Guid" 
                           Label="Select Inventory Item" 
                           Value="@_selectedItemId" 
                           ValueChanged="OnItemChanged"
                           Variant="Variant.Outlined" 
                           Class="text-slate-200">
                    @foreach (var item in _items)
                    {
                        <MudSelectItem Value="@item.Id">@item.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" Class="d-flex align-center">
                @if (_selectedItem != null)
                {
                    <div class="d-flex flex-column text-slate-300">
                        <span>Category: <b>@_selectedItem.Category?.Name</b></span>
                        <span>Tracking Mode: <b>@_selectedItem.BarcodeType</b></span>
                    </div>
                }
            </MudItem>
            <MudItem xs="12" sm="12" md="4" Class="d-flex align-center">
                <MudCheckBox T="bool" 
                             Value="@_showBarcodeDetails" 
                             ValueChanged="OnShowBarcodeDetailsChanged" 
                             Label="Show Detailed Barcode Info (In/Out with Photos)" 
                             Color="Color.Primary" 
                             Class="text-slate-200" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudTable Items="@_ledger" 
              Hover="true" 
              Loading="@_loading" 
              Class="glass-panel text-slate-200">
        <ToolBarContent>
            <MudText Typo="Typo.h6" Style="font-family: 'Outfit'; color: #E2E8F0;">Transaction ledger</MudText>
            <MudSpacer />
        </ToolBarContent>
        <HeaderContent>
            <MudTh Style="color: #94A3B8;">Date & Time</MudTh>
            <MudTh Style="color: #94A3B8;">Type</MudTh>
            <MudTh Style="color: #94A3B8;">Reference No</MudTh>
            <MudTh Style="color: #94A3B8;">Batch No</MudTh>
            <MudTh Style="color: #94A3B8;">Tracking No</MudTh>
            <MudTh Style="color: #94A3B8; text-align: right;">Inward Qty</MudTh>
            <MudTh Style="color: #94A3B8; text-align: right;">Outward Qty</MudTh>
            <MudTh Style="color: #94A3B8; text-align: right;">Running Balance</MudTh>
            <MudTh Style="color: #94A3B8; text-align: right;">Unit Price</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Date & Time" Class="text-slate-300">@context.TransactionDate.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</MudTd>
            <MudTd DataLabel="Type">
                @if (context.TransactionType == "Purchase")
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small">Inward</MudChip>
                }
                else if (context.TransactionType == "Sales")
                {
                    <MudChip T="string" Color="Color.Info" Size="Size.Small">Outward</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Warning" Size="Size.Small">@context.TransactionType</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Reference No" Class="text-slate-200 font-weight-bold">@context.ReferenceNo</MudTd>
            <MudTd DataLabel="Batch No" Class="text-slate-200">@context.BatchNo</MudTd>
            <MudTd DataLabel="Tracking No" Class="text-slate-400 font-mono" Style="font-size: 11px;">@context.TrackingNo</MudTd>
            <MudTd DataLabel="Inward Qty" Style="text-align: right;" Class="text-green-400 font-weight-bold">
                @(context.InwardQty > 0 ? $"+{context.InwardQty.ToString("N2")}" : "-")
            </MudTd>
            <MudTd DataLabel="Outward Qty" Style="text-align: right;" Class="text-red-400 font-weight-bold">
                @(context.OutwardQty > 0 ? $"-{context.OutwardQty.ToString("N2")}" : "-")
            </MudTd>
            <MudTd DataLabel="Running Balance" Style="text-align: right;" Class="text-slate-100 font-weight-bold">@context.BalanceQty.ToString("N2")</MudTd>
            <MudTd DataLabel="Unit Price" Style="text-align: right;" Class="text-slate-300">₹@context.UnitPrice.ToString("N2")</MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>

    @if (_showBarcodeDetails)
    {
        <MudTable id="barcode-table-container"
                  Items="@_barcodeDetails" 
                  Hover="true" 
                  Loading="@_loadingBarcodes" 
                  Class="glass-panel text-slate-200 mt-6">
            <ToolBarContent>
                <MudText Typo="Typo.h6" Style="font-family: 'Outfit'; color: #E2E8F0;">
                    <MudIcon Icon="@Icons.Material.Filled.QrCode" Class="mr-2 text-cyan" /> Detailed Barcode In/Out Logs
                </MudText>
                <MudSpacer />
                <MudMenu StartIcon="@Icons.Material.Filled.Download" Label="Export Barcodes" Color="Color.Info" Variant="Variant.Filled" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" Class="mr-2">
                    <MudMenuItem OnClick="ExportBarcodesExcel" Icon="@Icons.Custom.FileFormats.FileExcel" IconColor="Color.Success">Excel (.xlsx)</MudMenuItem>
                    <MudMenuItem OnClick="ExportBarcodesCsv" Icon="@Icons.Material.Filled.TextSnippet" IconColor="Color.Info">CSV (.csv)</MudMenuItem>
                    <MudMenuItem OnClick="ExportBarcodesPdf" Icon="@Icons.Material.Filled.PictureAsPdf" IconColor="Color.Error">PDF Report (.pdf)</MudMenuItem>
                </MudMenu>
            </ToolBarContent>
            <HeaderContent>
                <MudTh Style="color: #94A3B8; text-align: center; width: 60px;">Photo</MudTh>
                <MudTh Style="color: #94A3B8;">Item Name</MudTh>
                <MudTh Style="color: #94A3B8;">Barcode No</MudTh>
                <MudTh Style="color: #94A3B8;">Batch No</MudTh>
                <MudTh Style="color: #94A3B8;">Tracking No</MudTh>
                <MudTh Style="color: #94A3B8;">Type</MudTh>
                <MudTh Style="color: #94A3B8;">Inward Date</MudTh>
                <MudTh Style="color: #94A3B8;">Outward Date</MudTh>
                <MudTh Style="color: #94A3B8;">Status</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd Style="text-align: center;">
                    @if (!string.IsNullOrEmpty(context.ImageUrl))
                    {
                        <img src="@GetAbsoluteImageUrl(context.ImageUrl)" style="width: 40px; height: 40px; border-radius: 6px; object-fit: cover; border: 1px solid #5C5CFF; cursor: pointer;" @onclick="@(() => PreviewImage(context.ImageUrl))" />
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.ImageNotSupported" Color="Color.Dark" />
                    }
                </MudTd>
                <MudTd DataLabel="Item Name" Class="text-slate-100 font-weight-bold">@context.ItemName</MudTd>
                <MudTd DataLabel="Barcode No" Class="text-slate-200 font-mono">@context.BarcodeNo</MudTd>
                <MudTd DataLabel="Batch No" Class="text-slate-300">@context.BatchNo</MudTd>
                <MudTd DataLabel="Tracking No" Class="text-slate-400 font-mono" Style="font-size: 11px;">@context.TrackingNo</MudTd>
                <MudTd DataLabel="Type">
                    <MudChip T="string" Color="Color.Default" Size="Size.Small">@context.Type</MudChip>
                </MudTd>
                <MudTd DataLabel="Inward Date" Class="text-slate-300">@context.InwardDate.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</MudTd>
                <MudTd DataLabel="Outward Date" Class="text-slate-300">
                    @(context.OutwardDate.HasValue ? context.OutwardDate.Value.LocalDateTime.ToString("yyyy-MM-dd HH:mm") : "-")
                </MudTd>
                <MudTd DataLabel="Status">
                    @if (context.Status == "Issued")
                    {
                        <MudChip T="string" Color="Color.Error" Size="Size.Small">Issued</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Success" Size="Size.Small">In Stock</MudChip>
                    }
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    }
</MudContainer>

@code {
    private List<Item> _items = new();
    private Guid _selectedItemId = Guid.Empty;
    private Item? _selectedItem;
    
    private List<StockLedger> _ledger = new();
    private bool _loading = false;

    private bool _showBarcodeDetails = false;
    private List<BarcodeDetailReportDto> _barcodeDetails = new();
    private bool _loadingBarcodes = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadItems();
    }

    private async Task LoadItems()
    {
        try
        {
            _items = await Http.GetFromJsonAsync<List<Item>>("api/masters/items") ?? new();
            if (_items.Any())
            {
                _selectedItemId = _items.First().Id;
                _selectedItem = _items.First();
                await LoadLedger();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading items: {ex.Message}", Severity.Error);
        }
    }

    private async Task OnItemChanged(Guid itemId)
    {
        _selectedItemId = itemId;
        _selectedItem = _items.FirstOrDefault(i => i.Id == itemId);
        await LoadLedger();
    }

    private async Task LoadLedger()
    {
        if (_selectedItemId == Guid.Empty) return;
        
        _loading = true;
        StateHasChanged();
        try
        {
            _ledger = await Http.GetFromJsonAsync<List<StockLedger>>($"api/reports/ledger/{_selectedItemId}") ?? new();
            if (_showBarcodeDetails)
            {
                await LoadBarcodeDetails();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading ledger records: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task OnShowBarcodeDetailsChanged(bool val)
    {
        _showBarcodeDetails = val;
        if (_showBarcodeDetails)
        {
            await LoadBarcodeDetails();
        }
    }

    private async Task LoadBarcodeDetails()
    {
        if (!_showBarcodeDetails) return;
        _loadingBarcodes = true;
        StateHasChanged();
        try
        {
            _barcodeDetails.Clear();
            var batchTrackings = _ledger
                .Select(l => new { l.BatchNo, l.TrackingNo })
                .Distinct()
                .ToList();

            foreach (var bt in batchTrackings)
            {
                var details = await LoadBarcodeDetailsAsync(bt.BatchNo, bt.TrackingNo);
                if (details != null && details.Any())
                {
                    foreach (var d in details)
                    {
                        if (!_barcodeDetails.Any(b => b.BarcodeNo == d.BarcodeNo))
                        {
                            _barcodeDetails.Add(d);
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading barcode details: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loadingBarcodes = false;
            StateHasChanged();
        }
    }

    private async Task<List<BarcodeDetailReportDto>> LoadBarcodeDetailsAsync(string? batchNo, string? trackingNo)
    {
        try
        {
            var response = await Http.GetAsync($"api/reports/barcodes/detail?batchNo={Uri.EscapeDataString(batchNo ?? "")}&trackingNo={Uri.EscapeDataString(trackingNo ?? "")}");
            if (response.IsSuccessStatusCode)
            {
                var details = await response.Content.ReadFromJsonAsync<List<BarcodeDetailReportDto>>();
                if (details != null)
                {
                    foreach (var d in details)
                    {
                        if (!string.IsNullOrEmpty(d.ImageUrl) && d.ImageUrl.Contains(".supabase.co/storage/v1/", StringComparison.OrdinalIgnoreCase))
                        {
                            _ = Task.Run(async () => {
                                var base64 = await ImageLoader.LoadImageAsBase64Async(d.ImageUrl);
                                if (!string.IsNullOrEmpty(base64))
                                {
                                    d.ImageUrl = base64;
                                    await InvokeAsync(StateHasChanged);
                                }
                            });
                        }
                    }
                    return details;
                }
            }
        }
        catch
        {
            // Fallback
        }

        try
        {
            var code = !string.IsNullOrEmpty(trackingNo) ? trackingNo : batchNo;
            if (!string.IsNullOrEmpty(code))
            {
                var response = await Http.GetAsync($"api/reports/barcode-tracking/{Uri.EscapeDataString(code)}");
                if (response.IsSuccessStatusCode)
                {
                    var tracking = await response.Content.ReadFromJsonAsync<BarcodeTrackingReportDto>();
                    if (tracking != null)
                    {
                        var list = new List<BarcodeDetailReportDto>();
                        foreach (var bc in tracking.RegisteredBarcodes)
                        {
                            var isUnique = tracking.RegisteredBarcodes.Count > 1;
                            var issue = tracking.Issues.FirstOrDefault();
                            
                            var item = new BarcodeDetailReportDto
                            {
                                ItemName = tracking.ItemName,
                                BarcodeNo = bc,
                                BatchNo = tracking.BatchNo,
                                TrackingNo = tracking.TrackingNo,
                                Type = isUnique ? "Unique" : "Batch",
                                InwardDate = tracking.InwardDate,
                                OutwardDate = issue?.OutwardDate,
                                Status = issue != null ? "Issued" : "In Stock",
                                ImageUrl = tracking.PhotoUrl
                            };
                            
                            if (!string.IsNullOrEmpty(item.ImageUrl) && item.ImageUrl.Contains(".supabase.co/storage/v1/", StringComparison.OrdinalIgnoreCase))
                            {
                                _ = Task.Run(async () => {
                                    var base64 = await ImageLoader.LoadImageAsBase64Async(item.ImageUrl);
                                    if (!string.IsNullOrEmpty(base64))
                                    {
                                        item.ImageUrl = base64;
                                        await InvokeAsync(StateHasChanged);
                                    }
                                });
                            }
                            
                            list.Add(item);
                        }
                        return list;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading barcode fallback: {ex.Message}", Severity.Warning);
        }

        return new List<BarcodeDetailReportDto>();
    }

    private string GetAbsoluteImageUrl(string? url)
    {
        if (string.IsNullOrEmpty(url)) return string.Empty;
        
        if (url.Contains(".supabase.co/storage/v1/", StringComparison.OrdinalIgnoreCase))
        {
            var baseAddress = Http.BaseAddress?.ToString().TrimEnd('/') ?? "";
            return $"{baseAddress}/api/storage/image?url={Uri.EscapeDataString(url)}";
        }
        
        var uploadsIndex = url.IndexOf("/uploads/", StringComparison.OrdinalIgnoreCase);
        if (uploadsIndex >= 0)
        {
            var relativePath = url.Substring(uploadsIndex);
            var baseAddress = Http.BaseAddress?.ToString().TrimEnd('/') ?? "";
            return $"{baseAddress}{relativePath}";
        }
        
        if (url.StartsWith("uploads/", StringComparison.OrdinalIgnoreCase))
        {
            var baseAddress = Http.BaseAddress?.ToString().TrimEnd('/') ?? "";
            return $"{baseAddress}/{url}";
        }

        if (url.StartsWith("http://localhost") || url.StartsWith("https://localhost"))
        {
            var uri = new Uri(url);
            var relativePath = uri.PathAndQuery;
            var baseAddress = Http.BaseAddress?.ToString().TrimEnd('/') ?? "";
            return $"{baseAddress}{relativePath}";
        }

        if (url.StartsWith("http://", StringComparison.OrdinalIgnoreCase))
        {
            return "https://" + url.Substring(7);
        }

        return url;
    }

    private async Task PreviewImage(string url)
    {
        var resolvedUrl = await ImageLoader.LoadImageAsBase64Async(url);
        var absoluteUrl = GetAbsoluteImageUrl(resolvedUrl);
        var parameters = new DialogParameters { ["imageUrl"] = absoluteUrl };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium };
        await DialogService.ShowAsync<ImagePreviewDialog>("Item Photo", parameters, options);
    }

    private async Task ExportBarcodesExcel() => await ExportBarcodes("excel");
    private async Task ExportBarcodesCsv() => await ExportBarcodes("csv");
    private async Task ExportBarcodesPdf() => await ExportBarcodes("pdf");

    private async Task ExportBarcodes(string format)
    {
        if (!_barcodeDetails.Any())
        {
            Snackbar.Add("No barcode details to export.", Severity.Warning);
            return;
        }

        try
        {
            if (format == "pdf")
            {
                await JSRuntime.InvokeVoidAsync("webcamInterop.printElement", "barcode-table-container", "Detailed Barcode In/Out Logs");
                Snackbar.Add("Print preview opened for PDF export.", Severity.Info);
                return;
            }

            if (format == "csv")
            {
                var csvContent = GenerateBarcodesCsv();
                var bytes = System.Text.Encoding.UTF8.GetBytes(csvContent);
                var base64 = Convert.ToBase64String(bytes);
                var fileName = $"BarcodeLogs_{DateTime.Now:yyyyMMddHHmmss}.csv";
                await JSRuntime.InvokeVoidAsync("webcamInterop.downloadFile", fileName, "text/csv", base64);
                Snackbar.Add("Barcodes CSV exported successfully!", Severity.Success);
            }
            else // Excel (.xlsx / .xls)
            {
                var excelContent = GenerateBarcodesExcelHtml();
                var bytes = System.Text.Encoding.UTF8.GetBytes(excelContent);
                var base64 = Convert.ToBase64String(bytes);
                var fileName = $"BarcodeLogs_{DateTime.Now:yyyyMMddHHmmss}.xls";
                await JSRuntime.InvokeVoidAsync("webcamInterop.downloadFile", fileName, "application/vnd.ms-excel", base64);
                Snackbar.Add("Barcodes Excel exported successfully!", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error exporting barcodes: {ex.Message}", Severity.Error);
        }
    }

    private string GenerateBarcodesCsv()
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Item Name,Barcode No,Batch No,Tracking No,Type,Inward Date,Outward Date,Status");
        foreach (var item in _barcodeDetails)
        {
            sb.Append(EscapedCsv(item.ItemName)).Append(",")
              .Append(EscapedCsv(item.BarcodeNo)).Append(",")
              .Append(EscapedCsv(item.BatchNo)).Append(",")
              .Append(EscapedCsv(item.TrackingNo)).Append(",")
              .Append(EscapedCsv(item.Type)).Append(",")
              .Append(EscapedCsv(item.InwardDate.LocalDateTime.ToString("yyyy-MM-dd HH:mm"))).Append(",")
              .Append(EscapedCsv(item.OutwardDate.HasValue ? item.OutwardDate.Value.LocalDateTime.ToString("yyyy-MM-dd HH:mm") : "-")).Append(",")
              .Append(EscapedCsv(item.Status)).Append("\n");
        }
        return sb.ToString();
    }

    private string EscapedCsv(string val)
    {
        if (string.IsNullOrEmpty(val)) return "";
        if (val.Contains(",") || val.Contains("\"") || val.Contains("\n") || val.Contains("\r"))
        {
            return "\"" + val.Replace("\"", "\"\"") + "\"";
        }
        return val;
    }

    private string GenerateBarcodesExcelHtml()
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("<html><head><meta charset=\"utf-8\"><style>table { border-collapse: collapse; } th, td { border: 1px solid #000; padding: 5px; }</style></head><body>");
        sb.AppendLine("<table border=\"1\">");
        sb.AppendLine("<thead><tr><th>Item Name</th><th>Barcode No</th><th>Batch No</th><th>Tracking No</th><th>Type</th><th>Inward Date</th><th>Outward Date</th><th>Status</th></tr></thead>");
        sb.AppendLine("<tbody>");
        foreach (var item in _barcodeDetails)
        {
            sb.Append("<tr>");
            sb.Append("<td>").Append(System.Net.WebUtility.HtmlEncode(item.ItemName)).Append("</td>");
            sb.Append("<td>").Append(System.Net.WebUtility.HtmlEncode(item.BarcodeNo)).Append("</td>");
            sb.Append("<td>").Append(System.Net.WebUtility.HtmlEncode(item.BatchNo)).Append("</td>");
            sb.Append("<td>").Append(System.Net.WebUtility.HtmlEncode(item.TrackingNo)).Append("</td>");
            sb.Append("<td>").Append(System.Net.WebUtility.HtmlEncode(item.Type)).Append("</td>");
            sb.Append("<td>").Append(item.InwardDate.LocalDateTime.ToString("yyyy-MM-dd HH:mm")).Append("</td>");
            sb.Append("<td>").Append(item.OutwardDate.HasValue ? item.OutwardDate.Value.LocalDateTime.ToString("yyyy-MM-dd HH:mm") : "-").Append("</td>");
            sb.Append("<td>").Append(System.Net.WebUtility.HtmlEncode(item.Status)).Append("</td>");
            sb.Append("</tr>");
        }
        sb.AppendLine("</tbody></table></body></html>");
        return sb.ToString();
    }
}
