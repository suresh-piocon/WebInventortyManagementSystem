                      .Append($"<td>{row.ReferenceNo}</td>")
                      .Append($"<td>{row.BatchNo}</td>")
                      .Append($"<td>{row.TrackingNo}</td>")
                      .Append($"<td>{row.InwardQty:N2}</td>")
